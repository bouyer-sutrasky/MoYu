diff --git a/tests/pause-start.spec.ts b/tests/pause-start.spec.ts
new file mode 100644
index 0000000..724cbe1
--- /dev/null
+++ b/tests/pause-start.spec.ts
@@ -0,0 +1,223 @@
+/**
+ * A person's stop must land in bounded time whether the worker has not started yet (the launch is still
+ * preparing) or the start is in flight. Before this regression only a worker that could report its own
+ * stop ever settled the pause, so those phases stayed `stopping` for good: `paused.stoppedAt` never
+ * arrived, the platform showed the ticket blocked, the resume was refused for ever, and the execution
+ * lease stayed held.
+ *
+ * The two entrances differ in one fact, and these tests keep it: a Web ticket is accepted with its first
+ * Assignment (the launch is queued or already preparing), while a GitHub ticket waits in
+ * `pending_admission` with no Assignment at all until the platform admits it.
+ *
+ * The other shape a stop can take is to refuse it and leave the ticket `queued`, which was rejected:
+ * the pause transaction has already committed and the platform already shows the request, so a refusal
+ * would hand the ticket back to a launch that may still prompt a worker after the person asked it to
+ * stop. Settling instead is the honest answer, because it is true: a start ended before it prepared or
+ * prompted anything leaves no turn, no job and no subagent of the ticket, which is exactly what
+ * `stoppedAt` claims. The ticket also stays resumable, since a resume prepares the workspace again; the
+ * cost is that the work in flight is dropped rather than finished, which is what a stop asks for.
+ */
+import { spawn } from 'node:child_process'
+import { once } from 'node:events'
+import { describe, expect, it, vi } from 'vitest'
+import { projectTicketState, workspaceTrigger } from '../src/app/bridge.ts'
+import { latestAssignment } from '../src/core/index.ts'
+import type { Ticket, Trigger } from '../src/core/index.ts'
+import { workspaceKind } from '../src/sources/workspace.ts'
+import { startRuntime, type Host } from './fixtures/host.ts'
+
+const OWNER = 'owner'
+/** How long a stop may take to land before the test calls it stuck; under vitest's own 5 s cap so a
+ * stuck pause fails on this bound with the reason, not on the runner's timeout. */
+const BOUND_MS = 3_000
+/** The prepare command the fixture's subprocess mock holds until the test releases it. */
+const PREPARE = 'git worktree add'
+
+const wsTrigger = (id = 'workspace:m1'): Trigger => workspaceTrigger({
+  triggerId: id, conversationId: 'c1', messageId: id, actor: { id: OWNER, name: 'MoYu Owner' },
+  text: 'Fix the margin', at: '2026-11-03T12:00:00.000Z',
+  executionSpec: { repository: 'acme/widgets', baseBranch: 'main', baseCommit: null,
+    model: { provider: 'commandcode', model: 'deepseek/deepseek-v4-flash' }, mode: 'execute' },
+}, 'abc123', { model: { provider: 'commandcode', model: 'deepseek/deepseek-v4-flash' }, source: 'spec' })
+
+/** Registers the Web Source and admits its owner, as a Bridge-delivered conversation is. */
+async function webRuntime(): Promise<Host> {
+  const host = await startRuntime()
+  host.runtime.sources.register(workspaceKind)
+  const settings = host.runtime.store.settings()
+  host.runtime.store.saveSettings({ ...settings,
+    // A prepare command the test can hold, as a real worktree checkout holds the launch.
+    executor: { ...settings.executor, prepare: PREPARE },
+    policy: { ...settings.policy, sources: { ...settings.policy.sources, workspace: { allowed: [{ id: OWNER, name: 'MoYu Owner' }], bots: [] } } } })
+  return host
+}
+
+/** Holds the prepare command until the returned release runs. */
+function holdPrepare(host: Host): () => void {
+  let release = (): void => {}
+  host.hooks.prepare = new Promise<void>(resolve => { release = resolve })
+  return release
+}
+
+/** Waits for a predicate the runtime reaches asynchronously; fails the test's own bound. */
+async function waitFor(what: string, check: () => boolean, boundMs = BOUND_MS): Promise<void> {
+  const deadline = Date.now() + boundMs
+  while (!check()) {
+    if (Date.now() > deadline) throw new Error(`timed out waiting for ${what}`)
+    await new Promise(resolve => setTimeout(resolve, 10))
+  }
+}
+
+/** Accepts one ticket without waiting for its launch, which the test is racing. */
+async function acceptTicket(host: Host, trigger: Trigger): Promise<Ticket> {
+  host.runtime.receive(trigger)
+  // The ticket does not exist yet, so nothing is launching: `idle()` here only settles the assessment request.
+  await host.runtime.idle()
+  const result = await host.route({ kind: 'accept', trigger_id: trigger.id, title: 'Fix the margin', worktree_name: 'fix-margin',
+    acknowledgement: '收到。' })
+  return host.runtime.store.tickets.get((result.ticket as { ticket_id: string }).ticket_id)!
+}
+
+/** The spawn specs of the ticket's prepare command. */
+const prepareSpawns = (host: Host) => host.subprocess.spawn.mock.calls
+  .map(call => call[0] as { argv: readonly string[]; signal?: AbortSignal })
+  .filter(spec => spec.argv.includes(PREPARE))
+
+/** Accepts one Web ticket with its launch already inside its prepare command. */
+async function acceptedWebTicket(host: Host, trigger = wsTrigger()): Promise<Ticket> {
+  const ticket = await acceptTicket(host, trigger)
+  await waitFor('the launch to start preparing', () => prepareSpawns(host).length > 0)
+  return host.runtime.store.tickets.get(ticket.id)!
+}
+
+/** The ticket as stored once the pause landed, waiting for it within the bound. */
+async function pausedTicket(host: Host, ticketId: string, boundMs = BOUND_MS): Promise<Ticket> {
+  const deadline = Date.now() + boundMs
+  for (;;) {
+    const ticket = host.runtime.store.tickets.get(ticketId)!
+    if (ticket.paused?.stoppedAt || ticket.paused?.error || Date.now() > deadline) return ticket
+    await new Promise(resolve => setTimeout(resolve, 20))
+  }
+}
+
+describe('a stop before the worker starts', () => {
+  it('lands for a Web ticket whose launch is still preparing, instead of leaving it stopping', async () => {
+    const host = await webRuntime()
+    const release = holdPrepare(host)
+    try {
+      const ticket = await acceptedWebTicket(host)
+      const assignment = latestAssignment(ticket)!
+      expect(assignment.state).toBe('pending')
+      host.runtime.engine.pauseTicket(ticket.id, 'op-pause-web')
+      const paused = await pausedTicket(host, ticket.id)
+      // A stop that never lands is the defect: `stoppedAt` must arrive, and with it the stopped projection.
+      expect(paused.paused?.error).toBeUndefined()
+      expect(paused.paused?.stoppedAt).toEqual(expect.any(String))
+      expect(projectTicketState(paused)).toBe('stopped')
+      // The start in flight was ended, not left preparing behind the pause: its process was signalled.
+      await waitFor('the prepare signal to abort', () => prepareSpawns(host).every(spec => spec.signal?.aborted === true))
+      // And no worker was ever prompted with the assignment.
+      expect(host.relays(`worker-${ticket.id}`)).toHaveLength(0)
+    } finally {
+      release()
+      await host.stop()
+    }
+  })
+
+  it('lands for a GitHub ticket held in pending_admission with no Assignment at all', async () => {
+    const previous = process.env.MOYU_REQUIRE_ADMISSION
+    process.env.MOYU_REQUIRE_ADMISSION = '1'
+    const host = await startRuntime()
+    try {
+      host.runtime.receive({
+        id: 'github:1', source: 'github', threads: [{ source: 'github', id: 'github:acme/widgets:1' }],
+        actor: { source: 'github', id: 'alice' }, human: true, addressed: 'mention', at: '2026-11-03T12:00:00.000Z',
+        text: 'Fix it', meta: { number: 1, repository: 'acme/widgets' },
+      })
+      await host.runtime.idle()
+      const result = await host.route({ kind: 'accept', trigger_id: 'github:1', title: 'Fix it', worktree_name: 'fix-it',
+        acknowledgement: 'On it.' })
+      const ticket = host.runtime.store.tickets.get((result.ticket as { ticket_id: string }).ticket_id)!
+      // The GitHub entrance's difference: the platform has not admitted it, so it has no Assignment to stop.
+      expect(ticket.assignments).toHaveLength(0)
+      expect(projectTicketState(ticket)).toBe('pending_admission')
+      host.runtime.engine.pauseTicket(ticket.id, 'op-pause-github')
+      const paused = await pausedTicket(host, ticket.id)
+      expect(paused.paused?.error).toBeUndefined()
+      expect(paused.paused?.stoppedAt).toEqual(expect.any(String))
+      expect(projectTicketState(paused)).toBe('stopped')
+    } finally {
+      await host.stop()
+      if (previous === undefined) delete process.env.MOYU_REQUIRE_ADMISSION
+      else process.env.MOYU_REQUIRE_ADMISSION = previous
+    }
+  })
+
+  it('does not let another process of the same harness fail a clean stop', async () => {
+    const host = await webRuntime()
+    const release = holdPrepare(host)
+    // Another ticket's prepare command, a provider child or a shell job of the same harness: the process tree below the
+    // harness is shared, so it can never be this ticket's stop proof. A live child used to fail every stop with
+    // "process(es) remain", which is what the site showed.
+    const child = spawn('sleep', ['30'], { stdio: 'ignore' })
+    try {
+      const ticket = await acceptedWebTicket(host)
+      release()
+      await waitFor('the worker to start', () => host.agents.get(`worker-${ticket.id}`)?.status === 'running')
+      host.runtime.engine.pauseTicket(ticket.id, 'op-pause-shared-tree')
+      const paused = await pausedTicket(host, ticket.id)
+      expect(paused.paused?.error).toBeUndefined()
+      expect(paused.paused?.stoppedAt).toEqual(expect.any(String))
+      expect(projectTicketState(paused)).toBe('stopped')
+    } finally {
+      child.kill('SIGKILL')
+      await once(child, 'exit')
+      release()
+      await host.stop()
+    }
+  })
+})
+
+describe('a resume after a stop before the start', () => {
+  it('is accepted, because nothing ran and the launch prepares the workspace', async () => {
+    const host = await webRuntime()
+    const release = holdPrepare(host)
+    try {
+      const ticket = await acceptedWebTicket(host)
+      host.runtime.engine.pauseTicket(ticket.id, 'op-pause-resume')
+      const paused = await pausedTicket(host, ticket.id)
+      expect(paused.paused?.stoppedAt).toEqual(expect.any(String))
+      // The workspace never finished preparing, so the resume must not refuse it as a lost worktree.
+      release()
+      const resumed = host.runtime.engine.resumeTicket(ticket.id, { leaseId: 'lease-1', fencingToken: '1' })
+      expect(resumed.paused).toBeUndefined()
+      expect(latestAssignment(resumed)?.state).toBe('pending')
+      await waitFor('the resumed worker to start', () => host.agents.get(`worker-${ticket.id}`)?.status === 'running')
+      expect(host.runtime.store.tickets.get(ticket.id)!.paused).toBeUndefined()
+    } finally {
+      release()
+      await host.stop()
+    }
+  })
+})
+
+describe('the stop proof a pause records', () => {
+  it('names what stopped instead of the shared harness tree', async () => {
+    const host = await webRuntime()
+    const release = holdPrepare(host)
+    const settled = vi.spyOn(host.runtime.engine, 'pauseSettled')
+    try {
+      const ticket = await acceptedWebTicket(host)
+      host.runtime.engine.pauseTicket(ticket.id, 'op-evidence')
+      const paused = await pausedTicket(host, ticket.id)
+      const evidence = paused.paused?.evidence as Record<string, unknown>
+      expect(settled).toHaveBeenCalled()
+      expect(evidence).toMatchObject({ agentStatus: 'absent', jobsAfter: [], subagentsAfter: 0, launch: 'aborted' })
+      expect(evidence.lingeringPids).toBeUndefined()
+      expect(evidence.assignmentId).toEqual(latestAssignment(paused)!.id)
+    } finally {
+      release()
+      await host.stop()
+    }
+  })
+})
