+describe('task.progress from worker session events', () => {
+  it('takes assistant text (no reasoning), truncates to 4000 characters, and ignores chunks', async () => {
+    const h = harness()
+    h.repo.triggers.save(trigger())
+    h.repo.tickets.save(ticket('t1'))
+    const listeners: ((sessionId: string, event: { type: string; data: unknown }) => void)[] = []
+    h.host.subscribeSessionEvents = listener => { listeners.push(listener); return () => {} }
+    const { bridge, call } = await serve(h)
+    const content = [{ type: 'reasoning', text: 'internal reasoning' }, { type: 'text', text: 'Working on it' }]
+    for (const listener of listeners) {
+      listener('worker-t1', { type: 'assistant/message', data: { message: { id: 'msg1', content } } })
+      listener('worker-t1', { type: 'assistant/message', data: { message: { id: 'msg1', content } } })
+      listener('worker-t1', { type: 'assistant/delta', data: { text: 'chunk' } })
+      listener('worker-missing', { type: 'assistant/message', data: { message: { id: 'msg2', content } } })
+      listener('main-session', { type: 'assistant/message', data: { message: { id: 'msg3', content } } })
+    }
+    const events = (await call('GET', '/bridge/v1/events?after=0')).body.events as { id: string; type: string; data: Record<string, unknown> }[]
+    const progress = events.filter(event => event.type === 'task.progress')
+    expect(progress).toHaveLength(1)
+    expect(progress[0]).toMatchObject({ id: 'progress:worker-t1:msg1', data: { ticketId: 't1', sessionId: 'worker-t1', text: 'Working on it' } })
+    const long = 'x'.repeat(5000)
+    for (const listener of listeners) listener('worker-t1', { type: 'assistant/message', data: { message: { id: 'msg4', content: [{ type: 'text', text: long }] } } })
+    const again = (await call('GET', '/bridge/v1/events?after=2')).body.events as { type: string; data: Record<string, unknown> }[]
+    expect(again.at(-1)).toMatchObject({ type: 'task.progress', data: { text: 'x'.repeat(4000) } })
+  })
+})
