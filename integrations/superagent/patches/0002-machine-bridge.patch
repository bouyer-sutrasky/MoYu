+function harness(overrides: Partial<BridgeHost> = {}): Harness {
+  const repo = new MemoryRepositories()
+  const received: Trigger[] = []
+  const commands = { api: vi.fn(async (_schema: unknown, path: string) => ({ sha: path === 'commits/main' ? 'branch-sha' : 'commit-sha' })) }
+  const host: BridgeHost = {
+    stateDir: stateDir(), store: repo, commands: commands as never,
+    configured: () => true, deployment: testDeployment(),
