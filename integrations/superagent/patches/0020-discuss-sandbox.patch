+  /** Stops one external discussion run and records the same stop evidence as an in-process pause. */
+  private async pauseDiscuss(ticketId: string, assignmentId: string, operationId: string, run: DiscussRun): Promise<void> {
+    const startedAt = now()
+    const processesBefore = processTree()
+    const sessionId = run.sessionId
+    let pgid: number | undefined
+    try { pgid = Number(readFileSync(join(DISCUSS_ROOT, ticketId, assignmentId, 'shell.pid'), 'utf8').trim()) } catch { pgid = undefined }
+    run.controller.abort()
+    run.handle?.terminate()
+    if (pgid !== undefined && Number.isFinite(pgid)) {
+      try { process.kill(-pgid, 'SIGTERM') } catch { /* already gone */ }
+    }
+    const finished = await until(run.finished, this.host.lifetime, PAUSE_STOP_MS)
+    const processBeforePids = processesBefore.map(item => item.pid)
+    const aliveBefore = () => processBeforePids.filter(pid => {
+      try { process.kill(pid, 0); return true } catch { return false }
+    })
+    let lingeringPids = aliveBefore()
+    for (let wait = 0; lingeringPids.length > 0 && wait < 20; wait++) {
+      if (wait === 10 && pgid !== undefined && Number.isFinite(pgid)) {
+        try { process.kill(-pgid, 'SIGKILL') } catch { /* already gone */ }
+      }
+      await new Promise(resolve => setTimeout(resolve, 100))
+      lingeringPids = aliveBefore()
+    }
+    const processesAfter = processTree()
+    const stoppedAt = now()
+    const evidence = { ticketId, assignmentId, operationId, sessionId, harnessPid: process.pid, startedAt, stoppedAt,
+      agentStatus: 'idle', jobsBefore: [], jobsAfter: [], subagentsAfter: 0, processesBefore, processesAfter, lingeringPids,
+      cancelledTurn: true }
+    if (finished !== false && lingeringPids.length === 0) {
