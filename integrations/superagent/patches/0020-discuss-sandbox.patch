+  /** Runs a discussion in a separate, read-only environment and reports its plan. */
+  private async launchDiscussSandbox(ticket: Ticket, assignment: Assignment, command: string): Promise<void> {
+    const source = sourceTrigger(this.host, ticket)
+    const directory = ticket.execution?.directory ?? ''
+    if (!directory) {
+      this.host.engine.report(ticket.id, { state: 'failed', summary: 'The discussion has no worktree' })
+      return
+    }
+    if (!await stat(directory).then(() => true, () => false)) {
+      await this.prepareDirectory(ticket)
+      if (!liveTicket(this.host.store.tickets.get(ticket.id) ?? ticket)) return
+    }
+    const promptFile = join(dirname(directory), `.discuss-${assignment.id}.txt`)
+    const prompt = [`Read-only worktree: /srv/m4-discuss/workspace`, ticket.execution?.assignment ?? '',
+      source?.text ? `Source request:
+${source.text}` : ''].filter(Boolean).join('\n\n')
+    this.host.engine.assignmentStarted(ticket.id, assignment.id)
+    try {
+      await writeFile(promptFile, prompt, { mode: 0o644 })
+      const output = await runAsWorker(this.host.context.subprocess, ['sh', '-c', command], dirname(directory),
+        AbortSignal.any([this.host.lifetime, AbortSignal.timeout(15 * 60_000)]),
+        { DSH_DISCUSS_WORKTREE: directory, DSH_DISCUSS_PROMPT_FILE: promptFile })
+      this.host.engine.report(ticket.id, { state: 'ready', summary: output.trim() || 'Discussion completed.' })
+    } catch (error) {
+      this.host.engine.report(ticket.id, { state: 'failed', summary: `Discussion sandbox failed: ${error instanceof Error ? error.message : String(error)}` })
+    } finally {
+      await rm(promptFile, { force: true })
+    }
+  }
