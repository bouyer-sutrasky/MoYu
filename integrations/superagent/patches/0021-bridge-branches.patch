+  /**
+   * `GET /bridge/v1/branches`: the configured repository's branches, for validating a selection and detecting a deleted
+   * branch. Reads 100 a page and stops at a short page; ten full pages report `hasMore` instead of reading without
+   * bound. A GitHub CLI failure is a 503 and a malformed answer a 502, so the platform can tell an unavailable
+   * repository from a broken one. This only reads.
+   */
+  private async branchesRoute(res: ServerResponse): Promise<void> {
+    const branches: { name: string; commit: string }[] = []
+    let hasMore = false
+    for (let page = 1; page <= BRANCH_MAX_PAGES; page += 1) {
+      let items: unknown[]
+      try {
+        const answer = await this.host.commands.api(z.array(z.unknown()), `branches?per_page=${BRANCH_PAGE_SIZE}&page=${page}`)
+        // The host parses with the schema above; re-check the shape so a host that does not still gets a 502, not a 500.
+        if (!Array.isArray(answer)) return json(res, 502, { error: 'The branch list is malformed' })
+        items = answer
+      } catch (error) {
+        // The CLI's own failure is temporary; an unparsable answer is a broken upstream contract.
+        if (error instanceof z.ZodError || error instanceof SyntaxError) return json(res, 502, { error: 'The branch list is malformed' })
+        return json(res, 503, { error: `The branch list is unavailable: ${errorText(error).slice(0, 200)}` })
+      }
+      const parsed = items.flatMap(item => {
+        const branch = BranchSchema.safeParse(item)
+        return branch.success ? [{ name: branch.data.name, commit: branch.data.commit?.sha || '' }] : []
+      })
+      // A page with entries but no usable branch answered something other than branches.
+      if (parsed.length === 0 && items.length > 0) return json(res, 502, { error: 'The branch list is malformed' })
+      branches.push(...parsed)
+      if (items.length < BRANCH_PAGE_SIZE) break
+      if (page === BRANCH_MAX_PAGES) hasMore = true
+    }
+    json(res, 200, { branches: branches.sort(byBranchName), hasMore })
+  }
+
