     const operation = this.operations.get(id)
diff --git a/tests/bridge-branches.spec.ts b/tests/bridge-branches.spec.ts
new file mode 100644
index 0000000..40a8a44
--- /dev/null
+++ b/tests/bridge-branches.spec.ts
@@ -0,0 +1,142 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { MemoryRepositories } from '../src/core/index.ts'
+import { Bridge, type BridgeHost } from '../src/app/bridge.ts'
+import { testDeployment } from './fixtures/deployment.ts'
+
+const MODEL = { provider: 'commandcode', model: 'deepseek/deepseek-v4.1-flash', reasoningEffort: 'high' }
+const stateDirs: string[] = []
+const bridges: Bridge[] = []
+afterEach(async () => {
+  await Promise.all(bridges.splice(0).map(bridge => bridge.stop()))
+  for (const dir of stateDirs.splice(0)) rmSync(dir, { recursive: true, force: true })
+})
+const stateDir = (): string => {
+  const dir = mkdtempSync(join(tmpdir(), 'bridge-branches-'))
+  stateDirs.push(dir)
+  return dir
+}
+
+type Api = (schema: unknown, path: string) => Promise<unknown>
+interface Harness {
+  host: BridgeHost
+  commands: { api: ReturnType<typeof vi.fn> }
+}
+function harness(api: Api): Harness {
+  const repo = new MemoryRepositories()
+  const commands = { api: vi.fn(api) }
+  const host: BridgeHost = {
+    stateDir: stateDir(), store: repo, commands: commands as never,
+    engine: { pauseTicket: vi.fn(), resumeTicket: vi.fn(), startTicket: vi.fn(), retryTicket: vi.fn() } as never,
+    configured: () => true, deployment: testDeployment(),
+    receive: trigger => { repo.triggers.save(trigger); return 'stored' },
+    models: async () => ({ default: { provider: 'commandcode', model: 'deepseek/deepseek-v4.1-flash' },
+      routableProviders: ['commandcode'], groups: [], failures: [] }),
+    verifyModel: async () => {},
+    executorModel: () => MODEL,
+    workspaceEnabled: () => true,
+    subscribeSessionEvents: () => () => {},
+  }
+  return { host, commands }
+}
+
+let token = 'bridge-token'
+/** Starts a Bridge on an ephemeral loopback port and returns a request helper with the machine bearer. */
+async function serve(h: Harness) {
+  const bridge = new Bridge(h.host)
+  bridges.push(bridge)
+  await bridge.start({ MOYU_BRIDGE_HOST: '127.0.0.1', MOYU_BRIDGE_PORT: '0', MOYU_BRIDGE_TOKEN: token })
+  const origin = `http://127.0.0.1:${bridge.boundPort}`
+  const call = async (method: string, path: string, headers: Record<string, string> = { authorization: `Bearer ${token}` }) => {
+    const response = await fetch(`${origin}${path}`, { method, headers })
+    return { status: response.status, body: await response.json() as Record<string, unknown> }
+  }
+  return { call }
+}
+
+const branch = (name: string, sha = `sha-${name}`) => ({ name, commit: { sha } })
+const names = (prefix: string, count: number): string[] => Array.from({ length: count }, (_, index) => `${prefix}${String(index).padStart(3, '0')}`)
+
+describe('GET /bridge/v1/branches', () => {
+  it('lists one page sorted by name with the head sha, and advertises the capability', async () => {
+    const h = harness(async () => [
+      { name: 'release', commit: { sha: 'sha-release' }, protected: true },
+      { name: 'main', commit: { sha: 'sha-main' } },
+      { name: 'feature/x', commit: { sha: 'sha-feature' } },
+      { name: 'no-head', commit: null },
+      { name: 'no-sha', commit: { sha: null } },
+    ])
+    const { call } = await serve(h)
+    expect(await call('GET', '/bridge/v1/branches')).toEqual({ status: 200, body: { branches: [
+      { name: 'feature/x', commit: 'sha-feature' },
+      { name: 'main', commit: 'sha-main' },
+      { name: 'no-head', commit: '' },
+      { name: 'no-sha', commit: '' },
+      { name: 'release', commit: 'sha-release' },
+    ], hasMore: false } })
+    // The host's `api` prefixes the configured repository; the Bridge itself only asks for branch pages.
+    expect(h.commands.api).toHaveBeenCalledTimes(1)
+    expect(h.commands.api).toHaveBeenCalledWith(expect.anything(), 'branches?per_page=100&page=1')
+    expect(await call('GET', '/bridge/v1/capabilities')).toMatchObject({ status: 200, body: { capabilities: {
+      trigger: true, events: true, tickets: true, models: true, branches: true, pause: true, resume: true, retry: true,
+      readOnlyDiscussion: true, start: true } } })
+  })
+
+  it('reads two pages while the first is full and stops at the short second page', async () => {
+    const first = names('branch-', 100).map(name => branch(name))
+    const second = [branch('zeta'), branch('zulu')]
+    const h = harness(async (_schema, path) => path === 'branches?per_page=100&page=1' ? first : second)
+    const { call } = await serve(h)
+    const response = await call('GET', '/bridge/v1/branches')
+    expect(response.status).toBe(200)
+    const body = response.body as { branches: { name: string; commit: string }[]; hasMore: boolean }
+    expect(body.hasMore).toBe(false)
+    expect(body.branches).toHaveLength(102)
+    expect(body.branches[0]).toEqual({ name: 'branch-000', commit: 'sha-branch-000' })
+    expect(body.branches.at(-1)).toEqual({ name: 'zulu', commit: 'sha-zulu' })
+    expect(h.commands.api.mock.calls.map(call => call[1])).toEqual([
+      'branches?per_page=100&page=1',
+      'branches?per_page=100&page=2',
+    ])
+  })
+
+  it('stops after ten full pages and reports hasMore instead of reading without bound', async () => {
+    const h = harness(async (_schema, path) => {
+      const page = new URLSearchParams(path.split('?')[1]).get('page')!
+      return names(`page-${page}-`, 100).map(name => branch(name))
+    })
+    const { call } = await serve(h)
+    const response = await call('GET', '/bridge/v1/branches')
+    expect(response.status).toBe(200)
+    expect(response.body).toMatchObject({ hasMore: true })
+    expect((response.body.branches as unknown[]).length).toBe(1000)
+    expect(h.commands.api).toHaveBeenCalledTimes(10)
+    expect(h.commands.api.mock.calls.at(-1)![1]).toBe('branches?per_page=100&page=10')
+  })
+
+  it('answers 503, not 500, when the GitHub CLI fails', async () => {
+    const h = harness(async () => { throw new Error('gh: Not Found (HTTP 404)') })
+    const { call } = await serve(h)
+    expect(await call('GET', '/bridge/v1/branches')).toEqual({ status: 503, body: {
+      error: 'The branch list is unavailable: gh: Not Found (HTTP 404)' } })
+  })
+
+  it('answers 502 for malformed or absent data', async () => {
+    for (const malformed of [null, { branches: [] }, [{ name: '', commit: { sha: 'sha-empty' } }]]) {
+      const h = harness(async () => malformed)
+      const { call } = await serve(h)
+      expect(await call('GET', '/bridge/v1/branches')).toEqual({ status: 502, body: { error: 'The branch list is malformed' } })
+    }
+  })
+
+  it('requires the machine bearer', async () => {
+    const h = harness(async () => [])
+    const { call } = await serve(h)
+    expect(await call('GET', '/bridge/v1/branches', {})).toEqual({ status: 401, body: { error: 'Unauthorized' } })
+    expect(await call('GET', '/bridge/v1/branches', { authorization: 'Bearer wrong' }))
+      .toEqual({ status: 401, body: { error: 'Unauthorized' } })
+    expect(h.commands.api).not.toHaveBeenCalled()
+  })
+})
