+/** A fake Cordis context with a job registry, subagents, and one worker Agent whose cancel makes it idle. */
+function executorHarness(options: { killThrows?: boolean } = {}) {
+  const jobs = new Map([['bash-1', { id: 'bash-1', owner: 'worker-t1', status: 'running', label: 'npm test' }]])
+  const jobsService = {
+    list: () => [...jobs.values()],
+    wait: async (id: string) => ({ status: jobs.get(id)?.status ?? 'killed' }),
+    kill: (id: string) => {
+      if (options.killThrows) throw new Error('kill refused')
+      jobs.delete(id)
+    },
+    events: { subscribe: () => () => {} },
+  }
+  const subagents = { waitForChildren: async () => true, listChildren: async () => [], drainChildren: async () => {} }
+  const ctx = new Context()
+  ctx.reflect.provide('jobs', jobsService)
+  ctx.reflect.provide('subagents', subagents)
+  let status = 'running'
+  const agent = {
+    id: 'worker-t1',
+    get status() { return status },
+    cancel: vi.fn(() => { status = 'idle' }),
+    whenIdle: () => status === 'idle' ? Promise.resolve() : Promise.resolve(),
+    session: { id: 'worker-t1', snapshotEvents: () => [], header: {} },
+  }
+  ctx.reflect.provide('agents', { get: (id: string) => id === 'worker-t1' ? agent : undefined })
+  const ticket = { id: 't1', assignments: [{ id: 'as1', state: 'ended' as const, createdAt: '2026-11-03T12:00:00.000Z' }] } as unknown as Ticket
+  const engine = { pauseSettled: vi.fn(), pauseFailed: vi.fn() }
+  const host = {
+    context: ctx, engine,
+    store: { afterCommit: (action: () => void) => action(), settings: () => SettingsSchema.parse({}), tickets: { get: () => ticket } },
+    effects: { handle: () => {} }, health: { get: () => undefined, set: () => {} },
+    lifetime: new AbortController().signal, machine: { stateDir: '/tmp/pause-test' },
+  }
+  const executor = new DshExecutor(host as never)
+  return { executor, agent, jobs, engine, ticket }
+}
+
+describe('DshExecutor.pause', () => {
+  it('cancels the turn keeping the inbox, kills the shell jobs, and records the stop evidence', async () => {
+    const h = executorHarness()
+    h.executor.pause(h.ticket, h.ticket.assignments[0]!, 'op-1')
+    await vi.waitFor(() => expect(h.engine.pauseSettled).toHaveBeenCalledTimes(1))
+    const [ticketId, assignmentId, evidence] = h.engine.pauseSettled.mock.calls[0]!
+    expect([ticketId, assignmentId]).toEqual(['t1', 'as1'])
+    expect(h.agent.cancel).toHaveBeenCalledWith({ kind: 'user' }, { keepInbox: true })
+    expect(h.jobs.size).toBe(0)
+    expect(evidence).toMatchObject({
+      ticketId: 't1', assignmentId: 'as1', operationId: 'op-1', sessionId: 'worker-t1', harnessPid: process.pid,
+      agentStatus: 'idle', jobsBefore: [{ id: 'bash-1', name: 'npm test' }], jobsAfter: [], subagentsAfter: 0, cancelledTurn: true,
+    })
+    expect(Date.parse(String(evidence.stoppedAt))).toBeGreaterThanOrEqual(Date.parse(String(evidence.startedAt)))
+    expect(evidence.cgroup === undefined || typeof evidence.cgroup === 'string').toBe(true)
+  })
+
+  it('records a failure instead of success when the jobs do not stop', async () => {
+    const h = executorHarness({ killThrows: true })
+    h.executor.pause(h.ticket, h.ticket.assignments[0]!, 'op-1')
+    await vi.waitFor(() => expect(h.engine.pauseFailed).toHaveBeenCalledTimes(1))
+    expect(h.engine.pauseSettled).not.toHaveBeenCalled()
+    expect(h.engine.pauseFailed.mock.calls[0]![2]).toEqual(expect.any(String))
+    expect(h.jobs.size).toBe(1)
+  })
+})
