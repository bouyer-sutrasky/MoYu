+    h.engine.evaluateDue()
+    expect(h.repo.tickets.get(accepted.id)!.paused).toBeDefined()
+    expect(h.starts).toHaveLength(startsBefore)
+  })
+})
+
+describe('resuming a paused ticket', () => {
+  const admission = { leaseId: 'lease-1', fencingToken: 'fence-1' }
+
+  it('requires stoppedAt and an execution lease admission', () => {
+    const h = harness()
+    const accepted = h.accept()
+    h.engine.pauseTicket(accepted.id, 'op-1')
+    expect(() => h.engine.resumeTicket(accepted.id, admission)).toThrow(/not finished stopping/)
+    h.engine.pauseSettled(accepted.id, latestAssignment(h.repo.tickets.get(accepted.id)!)!.id, {})
+    expect(() => h.engine.resumeTicket(accepted.id, undefined as never)).toThrow(/lease admission/)
+    expect(() => h.engine.resumeTicket(accepted.id, { leaseId: '', fencingToken: '' })).toThrow(/lease admission/)
+  })
+
+  it('keeps the same ticket, clears paused, records the admission, and starts a new Assignment', () => {
+    const h = harness()
+    const accepted = h.accept()
+    const old = latestAssignment(h.repo.tickets.get(accepted.id)!)!
+    h.engine.pauseTicket(accepted.id, 'op-1')
+    h.engine.pauseSettled(accepted.id, old.id, { ticketId: accepted.id })
+    const resumeInput = h.repo.tickets.get(accepted.id)!.inputs.length
+    const resumed = h.engine.resumeTicket(accepted.id, admission)
+    expect(resumed.id).toBe(accepted.id)
+    expect(resumed.paused).toBeUndefined()
+    expect(resumed.ended).toBeUndefined()
+    expect(resumed.admission).toEqual(admission)
+    expect(resumed.assignments).toHaveLength(2)
+    expect(resumed.assignments[1]).toMatchObject({ state: 'pending' })
+    expect(resumed.inputs).toHaveLength(resumeInput + 1)
+    expect(resumed.inputs.at(-1)).toMatchObject({ kind: 'text', text: expect.stringMatching(/stopped this ticket.*resumed/i) })
+    expect(resumed.undelivered[0]).toBe(resumed.inputs.at(-1)!.id)
+    expect(h.stops).toEqual([old.id])
+    expect(h.starts.at(-1)).toBe(resumed.assignments[1]!.id)
+  })
+
+  it('refuses a workspace ticket whose frozen record was lost', () => {
+    const h = harness()
+    const accepted = h.accept()
+    h.engine.pauseTicket(accepted.id, 'op-1')
+    h.engine.pauseSettled(accepted.id, latestAssignment(h.repo.tickets.get(accepted.id)!)!.id, {})
+    const lost = h.repo.tickets.get(accepted.id)!
+    delete lost.model
+    h.repo.tickets.save(lost)
+    expect(() => h.engine.resumeTicket(accepted.id, admission)).toThrow(/no longer present/)
+  })
+})
+
+describe('starting a discussion', () => {
+  it('flips mode on the same ticket, ends the discussion Assignment, and starts an execute Assignment', () => {
+    const h = harness()
+    const accepted = h.accept('discuss')
+    const discussion = latestAssignment(h.repo.tickets.get(accepted.id)!)!
+    const started = h.engine.startTicket(accepted.id, 2)
+    expect(started.id).toBe(accepted.id)
+    expect(started.mode).toBe('execute')
+    expect(started.planRevision).toBe(2)
+    expect(started.assignments).toHaveLength(2)
+    expect(started.assignments[0]).toMatchObject({ state: 'ended', endedReason: 'started' })
+    expect(started.inputs.at(-1)).toMatchObject({ kind: 'text', text: expect.stringMatching(/plan revision 2.*same worktree.*existing PR/i) })
+    expect(started.execution?.assignment).toContain('plan revision 2')
+    expect(h.stops).toContain(discussion.id)
+    expect(h.starts.at(-1)).toBe(started.assignments[1]!.id)
+  })
+
+  it('requires discuss mode, an open unpaused ticket, and planRevision >= 1', () => {
+    const h = harness()
+    const executing = h.accept()
+    expect(() => h.engine.startTicket(executing.id, 1)).toThrow(/discuss ticket/)
+    const h2 = harness()
+    const discussing = h2.accept('discuss')
+    expect(() => h2.engine.startTicket(discussing.id, 0)).toThrow(/plan revision/)
+    h2.engine.pauseTicket(discussing.id, 'op-1')
+    expect(() => h2.engine.startTicket(discussing.id, 1)).toThrow(/paused/)
+  })
+})
