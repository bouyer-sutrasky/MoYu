+    expect(readFileSync(join(git, 'info', 'exclude'), 'utf8')).toContain('.moyu/')
+    const first = statSync(path).mtimeMs
+    await materializeTriggerAttachments(workspace, stateDir, trigger([attachment()]))
+    expect(statSync(path).mtimeMs).toBe(first)
