diff --git a/src/core/attachments.ts b/src/core/attachments.ts
new file mode 100644
index 0000000..b9bbd5f
--- /dev/null
+++ b/src/core/attachments.ts
@@ -0,0 +1,35 @@
+/** Attachment references a workspace Trigger carries; the platform owns the bytes and the Runtime only reads them. */
+import { z } from 'zod'
+
+/**
+ * One attachment a platform message was sent with. The reference names and checks the bytes; it never carries them,
+ * and it never carries a URL, so a Trigger cannot point the Runtime at another host.
+ */
+export const TriggerAttachmentSchema = z.object({
+  id: z.uuid(),
+  filename: z.string().min(1).max(255),
+  mimeType: z.string().min(1).max(200),
+  sizeBytes: z.int().positive().max(10 * 1024 * 1024),
+  sha256: z.string().regex(/^[0-9a-f]{64}$/),
+  kind: z.enum(['image', 'text']),
+}).strict()
+
+export type TriggerAttachment = z.infer<typeof TriggerAttachmentSchema>
+
+/** Most attachments one message may deliver; mirrors the platform's per-message limit. */
+export const MAX_TRIGGER_ATTACHMENTS = 10
+/** Largest attachment the Runtime accepts, also enforcing the platform's per-file limit. */
+export const MAX_TRIGGER_ATTACHMENT_BYTES = 10 * 1024 * 1024
+
+/** Returns the attachments a Trigger's meta carries, empty for Triggers delivered before attachments existed. */
+export function triggerAttachments(trigger: { meta: Record<string, unknown> }): TriggerAttachment[] {
+  const parsed = z.array(TriggerAttachmentSchema).max(MAX_TRIGGER_ATTACHMENTS).safeParse(trigger.meta.attachments ?? [])
+  if (!parsed.success) throw new Error(`This Trigger carries invalid attachment references: ${parsed.error.issues.map(issue => issue.message).join('; ')}`)
+  return parsed.data
+}
+
+/** A filename that is safe as one path component: no separators, no leading dots, a stable fallback, and an extension kept for display. */
+export function attachmentFileName(attachment: Pick<TriggerAttachment, 'id' | 'filename'>): string {
+  const base = attachment.filename.replace(/^.*[\\/]/, '').replace(/[^A-Za-z0-9._-]/g, '_').replace(/^\.+/, '').slice(-160)
+  return base && base.replace(/[^A-Za-z0-9]/g, '') ? base : `${attachment.id}.bin`
+}
