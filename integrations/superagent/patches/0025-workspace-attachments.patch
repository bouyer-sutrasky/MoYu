@@ -0,0 +1,65 @@
+/** Copies a Trigger's verified attachments into the ticket workspace so read/read_image can consume them on demand. */
+import { createHash } from 'node:crypto'
+import { chmod, copyFile, mkdir, readFile, rename, stat } from 'node:fs/promises'
+import { dirname, isAbsolute, join, resolve } from 'node:path'
+import { attachmentFileName, triggerAttachments, type TriggerAttachment } from '../core/attachments.ts'
+import type { Trigger } from '../core/index.ts'
+import { stagedAttachmentPath } from '../app/attachments.ts'
+
+/** An attachment reference plus the workspace-relative path the worker reads. */
+export interface MaterializedAttachment extends TriggerAttachment { path: string }
+
+const sha256 = (bytes: Uint8Array): string => createHash('sha256').update(bytes).digest('hex')
+const exists = async (path: string) => stat(path).then(value => value.isFile(), () => false)
+
+/**
+ * Makes the Trigger's attachments readable from `workspace`: `.moyu/attachments/<id>/<name>`, mode 0600, excluded from git.
+ * A file that already matches its size and sha256 is kept, so a restart or a repeated delivery copies nothing twice.
+ */
+export async function materializeTriggerAttachments(workspace: string, stateDir: string, trigger: Trigger): Promise<MaterializedAttachment[]> {
+  const attachments = triggerAttachments(trigger)
+  if (!attachments.length) return []
+  if (!workspace) throw new Error('The ticket has no workspace for its attachments')
+  await excludeAttachmentDirectory(workspace)
+  const result: MaterializedAttachment[] = []
+  for (const attachment of attachments) {
+    const source = stagedAttachmentPath(stateDir, trigger.id, attachment)
+    const sourceStat = await stat(source).catch(() => undefined)
+    if (!sourceStat?.isFile()) throw new Error(`The staged attachment ${attachment.id} is missing`)
+    if (sourceStat.size !== attachment.sizeBytes || sha256(await readFile(source)) !== attachment.sha256) {
+      throw new Error(`The staged attachment ${attachment.id} no longer matches its sha256`)
+    }
+    const name = attachmentFileName(attachment)
+    const target = join(workspace, '.moyu', 'attachments', attachment.id, name)
+    if (!await exists(target) || sha256(await readFile(target)) !== attachment.sha256) {
+      await mkdir(dirname(target), { recursive: true, mode: 0o700 })
+      const temporary = `${target}.${process.pid}.part`
+      await copyFile(source, temporary)
+      await chmod(temporary, 0o600)
+      await rename(temporary, target)
+      await chmod(target, 0o600)
+    }
+    result.push({ ...attachment, path: `.moyu/attachments/${attachment.id}/${name}` })
+  }
+  return result
+}
+
+/** Adds `.moyu/` to the worktree's private exclude file, so attachments never appear in a diff or a commit. */
+async function excludeAttachmentDirectory(workspace: string): Promise<void> {
+  const git = join(workspace, '.git')
+  const gitStat = await stat(git).catch(() => undefined)
+  if (!gitStat) return
+  let directory = git
+  if (gitStat.isFile()) {
+    const pointer = /^gitdir:\s*(.+)$/m.exec(await readFile(git, 'utf8'))
+    if (!pointer) return
+    directory = isAbsolute(pointer[1]!.trim()) ? pointer[1]!.trim() : resolve(workspace, pointer[1]!.trim())
+  }
+  const exclude = join(directory, 'info', 'exclude')
+  try {
+    const current = await readFile(exclude, 'utf8').catch(() => '')
+    if (current.split('\n').includes('.moyu/')) return
+    await mkdir(dirname(exclude), { recursive: true })
+    await import('node:fs/promises').then(fs => fs.appendFile(exclude, `${current && !current.endsWith('\n') ? '\n' : ''}.moyu/\n`, { mode: 0o600 }))
+  } catch { /* a workspace without a writable git exclude still gets the files; only the gitignored view is best-effort */ }
+}
