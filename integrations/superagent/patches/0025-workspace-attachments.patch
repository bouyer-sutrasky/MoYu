index 0000000..2a3a3ee
--- /dev/null
+++ b/src/app/attachments.ts
@@ -0,0 +1,77 @@
+/** Stages a platform message's attachments beside the Runtime state, verifying every byte before any Ticket exists. */
+import { createHash, randomUUID } from 'node:crypto'
+import { chmod, mkdir, readFile, rename, rm, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { attachmentFileName, MAX_TRIGGER_ATTACHMENT_BYTES, type TriggerAttachment } from '../core/attachments.ts'
+
+/** How long one platform download may take before the Trigger is refused as temporarily unavailable. */
+const DOWNLOAD_TIMEOUT_MS = 30_000
+
+/** A refusal the Bridge answers with its own status: 422 for bytes it cannot accept, 503 for a platform that cannot serve them. */
+export class AttachmentError extends Error {
+  constructor(readonly status: 422 | 503, message: string) { super(message) }
+}
+
+/** The attachment fields a Trigger request needs to be staged. */
+export interface AttachmentRequest { triggerId: string; messageId: string; attachments?: TriggerAttachment[] | undefined }
+
+/** The directory a Trigger's verified bytes are staged under, one per Trigger so a retry overwrites the same files. */
+export const stagingDirectory = (stateDir: string, triggerId: string): string => join(stateDir, 'attachments', triggerId)
+
+/** Where one verified attachment waits for the Executor to copy it into a workspace. */
+export const stagedAttachmentPath = (stateDir: string, triggerId: string, attachment: TriggerAttachment): string =>
+  join(stagingDirectory(stateDir, triggerId), attachment.id, attachmentFileName(attachment))
+
+const sha256 = (bytes: Uint8Array): string => createHash('sha256').update(bytes).digest('hex')
+const errorText = (error: unknown): string => error instanceof Error ? error.message : String(error)
+
+/**
+ * Downloads and verifies every attachment of a Trigger into `stateDir`, or refuses the Trigger and removes what it staged.
+ * The bearer stays in this process: the platform URL is built from configuration, never from the request body.
+ */
+export async function stageTriggerAttachments(host: { stateDir: string }, request: AttachmentRequest,
+  env: NodeJS.ProcessEnv = process.env): Promise<void> {
+  const attachments = request.attachments ?? []
+  if (!attachments.length) return
+  const base = env.MOYU_PLATFORM_URL?.trim()
+  const token = env.MOYU_PLATFORM_TOKEN?.trim()
+  if (!base || !token) throw new AttachmentError(503, 'The Runtime has no platform credentials to fetch attachments')
+  let origin: URL
+  try { origin = new URL(base) } catch { throw new AttachmentError(503, 'MOYU_PLATFORM_URL is not a valid URL') }
+  if (origin.protocol !== 'http:' && origin.protocol !== 'https:') throw new AttachmentError(503, 'MOYU_PLATFORM_URL must be http or https')
+  const directory = stagingDirectory(host.stateDir, request.triggerId)
+  try {
+    for (const attachment of attachments) {
+      if (attachment.sizeBytes > MAX_TRIGGER_ATTACHMENT_BYTES) throw new AttachmentError(422, `Attachment ${attachment.id} exceeds the size limit`)
+      const url = new URL(`/api/internal/v1/messages/${encodeURIComponent(request.messageId)}/attachments/${encodeURIComponent(attachment.id)}`, origin)
+      let response: Response
+      try {
+        response = await fetch(url, { headers: { authorization: `Bearer ${token}`, accept: 'application/octet-stream' },
+          redirect: 'error', signal: AbortSignal.timeout(DOWNLOAD_TIMEOUT_MS) })
+      } catch (error) {
+        throw new AttachmentError(503, `The platform did not serve attachment ${attachment.id}: ${errorText(error)}`)
+      }
+      // A platform answer that names a missing/foreign attachment is a permanent refusal; a 5xx may succeed on retry.
+      if (response.status === 401 || response.status === 403 || response.status === 404 || response.status === 409) {
+        throw new AttachmentError(422, `The platform refused attachment ${attachment.id} (HTTP ${response.status})`)
+      }
+      if (!response.ok) throw new AttachmentError(503, `The platform failed to serve attachment ${attachment.id} (HTTP ${response.status})`)
+      const bytes = new Uint8Array(await response.arrayBuffer())
+      if (bytes.byteLength !== attachment.sizeBytes) {
+        throw new AttachmentError(422, `Attachment ${attachment.id} size mismatch: ${bytes.byteLength} != ${attachment.sizeBytes}`)
+      }
+      if (sha256(bytes) !== attachment.sha256) throw new AttachmentError(422, `Attachment ${attachment.id} sha256 mismatch`)
+      const target = join(directory, attachment.id)
+      await mkdir(target, { recursive: true, mode: 0o700 })
+      const file = join(target, attachmentFileName(attachment))
+      const temporary = `${file}.${randomUUID()}.part`
+      await writeFile(temporary, bytes, { mode: 0o600, flag: 'wx' })
+      await chmod(temporary, 0o600)
+      await rename(temporary, file)
+      await chmod(file, 0o600)
+    }
+  } catch (error) {
+    await rm(directory, { recursive: true, force: true })
+    throw error
+  }
+}
