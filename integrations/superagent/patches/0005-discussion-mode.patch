+import { SettingsSchema } from '../src/policy.ts'
+
+const ticket = (id: string, overrides: Partial<Ticket> = {}): Ticket => ({
+  id, title: `Fix ${id}`, decisionId: 'd1',
+  mandate: { strength: 'explicit', policyVersion: 'v1', basis: { via: 'listed' }, actor: { source: 'workspace', id: 'owner' }, scope: 'web' },
+  channels: [{ source: 'workspace', thread: 'workspace:c1', address: { conversationId: 'c1' } }],
+  assignments: [], inputs: [], undelivered: [], createdAt: '2026-11-03T12:00:00.000Z', updatedAt: '2026-11-03T12:00:00.000Z',
+  origin: { triggerId: 'workspace:m1', triggerIds: ['workspace:m1'] }, ...overrides,
+})
+
+/** Every tool the mock worker preset inherits, so the allow-list filters nothing away and can be asserted exactly. */
+const INHERITED = ['read', 'write', 'edit', 'read_image', 'glob', 'grep', 'bash', 'pwsh', 'job_output', 'job_list', 'job_kill',
+  'web_search', 'web_fetch', 'skill', 'todo_write', 'subagent', 'list_subagent_models', 'send_message', 'list_agents', 'interrupt_agent']
+
+interface Restriction { sessionId: string; allow: string[]; dispose: ReturnType<typeof vi.fn> }
+interface Harness {
+  sessions: Sessions
+  repo: MemoryRepositories
+  presets: { session: unknown; preset: string }[]
+  restrictions: Restriction[]
+  agents: Map<string, unknown>
+  settings: ReturnType<typeof SettingsSchema.parse>
+}
+
+/**
+ * A Cordis context and Agent mock as the existing runtime tests build them: a real `Context` per Agent, a preset scope with
+ * the tools a worker preset inherits, and the session controller, workspace registry, and permission presets `Sessions` uses.
+ */
+function harness(): Harness {
+  const repo = new MemoryRepositories()
+  repo.tickets.save(ticket('t1', { mode: 'discuss' }))
+  const settings = SettingsSchema.parse({})
+  const ctx = new Context()
+  const agents = new Map<string, unknown>()
+  const presets: Harness['presets'] = []
+  const restrictions: Restriction[] = []
+  const inherited = new Set(INHERITED)
+  const controller = {
+    create: vi.fn(async ({ sessionId }: { sessionId: string }) => {
+      if (agents.has(sessionId)) return
+      const agentCtx = new Context()
+      const preset = {}
+      agentCtx.reflect.provide('tools', {
+        register: () => () => {},
+        // Preset tools are inherited through the scope parent, exactly as the worker preset registers them.
+        get: (name: string, scope?: object) => (scope === preset || scope === agents.get(sessionId)) && inherited.has(name) ? { name } : undefined,
+        restrict: (rule: { allow: string[] }) => {
+          const dispose = vi.fn()
+          restrictions.push({ sessionId, allow: rule.allow, dispose })
+          return dispose
+        },
+        guard: () => () => {},
+      })
+      agentCtx.reflect.provide('skills', { register: () => () => {} })
+      agentCtx.reflect.provide('systemPrompt', { section: () => () => {} })
+      const agent = { id: sessionId, ctx: agentCtx, status: 'idle', inbox: { remove: () => false }, cancel: vi.fn(), whenIdle: async () => {},
+        session: { id: sessionId, header: { agentPreset: 'dsh-superagent-worker' }, requestHeader: () => undefined, snapshotEvents: () => [], append: () => {} } }
+      agents.set(sessionId, agent)
+      bindScopeParent(agent, preset)
+    }),
+    resolveAgent: vi.fn(async (id: string) => agents.has(id) ? { agent: agents.get(id) } : { error: { code: 'session/not-found' } }),
+    rename: vi.fn(async () => {}),
+  }
+  ctx.reflect.provide('sessionController', controller)
+  ctx.reflect.provide('workspaceRegistry', { create: async (cwd: string) => ({ id: cwd }) })
+  ctx.reflect.provide('permissionPresets', { set: (session: unknown, preset: string) => { presets.push({ session, preset }) } })
+  const store = { tickets: repo.tickets, settings: () => settings, get: () => undefined, set: () => {}, keys: () => [] }
+  const sessions = new Sessions({
+    context: ctx,
+    store: store as never,
+    prompts: { current: () => ({ revision: 0, config: {} }), compose: () => '', skills: () => new Map() } as never,
+    effects: { handle: () => {}, enqueue: () => {}, idle: async () => {}, pending: () => false } as never,
+    health: { set: () => {}, get: () => undefined } as never,
+    masterId: 'orchestrator',
+    lifetime: new AbortController().signal,
+    closing: () => false,
+    environment: () => [],
+    tools: () => [],
+  })
+  return { sessions, repo, presets, restrictions, agents, settings }
+}
+
+const ensure = (h: Harness, id: string, mode?: 'execute' | 'discuss') =>
+  h.sessions.ensure(id, `/tmp/${id}`, `Work ${id}`, 'worker', null, mode)
+
+describe('discussion tool boundary', () => {
+  it('offers only read-only tools: no write, shell, job, subagent, or message tool', () => {
+    expect(DISCUSS_TOOLS).toEqual(['read', 'read_image', 'glob', 'grep', 'web_search', 'web_fetch', 'skill', 'todo_write'])
+    for (const forbidden of ['write', 'edit', 'bash', 'pwsh', 'job_output', 'job_list', 'job_kill', 'subagent', 'list_subagent_models',
+      'send_message', 'list_agents', 'interrupt_agent']) {
+      expect(DISCUSS_TOOLS).not.toContain(forbidden)
+    }
+  })
+
+  it('restricts a discuss worker to DISCUSS_TOOLS and applies the read-only permission preset', async () => {
+    const h = harness()
+    await ensure(h, 'worker-t1', 'discuss')
+    expect(h.presets).toEqual([{ session: expect.anything(), preset: DISCUSS_PRESET }])
+    expect(h.restrictions).toHaveLength(1)
+    expect(h.restrictions[0]!.allow).toEqual(DISCUSS_TOOLS)
+    for (const forbidden of ['write', 'edit', 'bash', 'pwsh', 'job_output', 'job_list', 'job_kill', 'subagent', 'send_message']) {
+      expect(h.restrictions[0]!.allow).not.toContain(forbidden)
+    }
+  })
+
+  it('gives an execute worker the work tools and danger-full-access', async () => {
+    const h = harness()
+    h.repo.tickets.save(ticket('t2', { mode: 'execute' }))
+    await ensure(h, 'worker-t2', 'execute')
+    expect(h.presets).toEqual([{ session: expect.anything(), preset: EXECUTE_PRESET }])
+    expect(h.restrictions).toHaveLength(1)
+    expect(h.restrictions[0]!.allow).toContain('write')
+    expect(h.restrictions[0]!.allow).toContain('bash')
+    expect(h.restrictions[0]!.allow).toContain('subagent')
+  })
+
+  it('applies execute when a ticket records no mode, as for a Source that does not freeze one', async () => {
+    const h = harness()
+    h.repo.tickets.save(ticket('t3'))
+    await ensure(h, 'worker-t3')
+    expect(h.presets.at(-1)!.preset).toBe(EXECUTE_PRESET)
+    expect(h.restrictions[0]!.allow).toContain('write')
+  })
+
+  it('replaces the restriction binding when the same session moves from discuss to execute', async () => {
+    const h = harness()
+    await ensure(h, 'worker-t1', 'discuss')
+    const first = h.restrictions[0]!
+    h.repo.tickets.save(ticket('t1', { mode: 'execute' }))
+    await ensure(h, 'worker-t1', 'execute')
+    expect(first.dispose).toHaveBeenCalledTimes(1)
+    expect(h.restrictions).toHaveLength(2)
+    expect(h.restrictions[1]!.allow).toContain('write')
+    expect(h.restrictions[1]!.allow).toContain('bash')
+    expect(h.restrictions[1]!.allow).not.toEqual(DISCUSS_TOOLS)
+    expect(h.presets.map(item => item.preset)).toEqual([DISCUSS_PRESET, EXECUTE_PRESET])
+  })
+
+  it('keeps the binding when the mode did not change, instead of stacking restrictions', async () => {
+    const h = harness()
+    await ensure(h, 'worker-t1', 'discuss')
+    await ensure(h, 'worker-t1', 'discuss')
+    expect(h.restrictions).toHaveLength(1)
+    expect(h.restrictions[0]!.dispose).not.toHaveBeenCalled()
+  })
+})
+
+describe('the discussion assignment text', () => {
+  it('tells the worker it is a read-only discussion that proposes a plan', () => {
+    expect(DISCUSSION_ASSIGNMENT).toMatch(/read-only discussion/)
+    expect(DISCUSSION_ASSIGNMENT).toMatch(/plan/)
+    const executor = new DshExecutor({ store: { settings: () => SettingsSchema.parse({}) }, machine: { stateDir: '/tmp/state' },
+      effects: { handle: () => {} } } as never)
+    const prepared = executor.prepare(ticket('d1', { mode: 'discuss' }),
+      { kind: 'accept', title: 'Plan the margin', scope: 'small', reason: 'asked', name: 'plan-margin' })
+    expect(prepared.execution?.assignment).toContain(DISCUSSION_ASSIGNMENT)
+    const executing = executor.prepare(ticket('d2', { mode: 'execute' }),
+      { kind: 'accept', title: 'Fix the margin', scope: 'small', reason: 'asked', name: 'fix-margin' })
+    expect(executing.execution?.assignment).not.toContain(DISCUSSION_ASSIGNMENT)
+  })
+})
+
+describe('discussion state projection', () => {
+  const running = { id: 'as1', state: 'running' as const, createdAt: '2026-11-03T12:00:00.000Z' }
+  it('projects a live discuss ticket as discussing', () => {
+    expect(projectTicketState(ticket('d1', { mode: 'discuss' }))).toBe('discussing')
+    expect(projectTicketState(ticket('d2', { mode: 'discuss', assignments: [running] }))).toBe('discussing')
+    expect(projectTicketState(ticket('e1'))).toBe('queued')
+  })
+
+  it('lets an open question and a ready report win over discussing', () => {
+    expect(projectTicketState(ticket('d3', { mode: 'discuss', attention: { id: 'a1', question: 'Which approach?' } }))).toBe('waiting_input')
+    expect(projectTicketState(ticket('d4', { mode: 'discuss', assignments: [{ ...running,
+      report: { state: 'ready', summary: 'Plan ready', at: '2026-11-03T12:00:01.000Z' } }] }))).toBe('awaiting_review')
+  })
+
+  it('keeps the execute projection for an execute ticket', () => {
+    expect(projectTicketState(ticket('x1', { mode: 'execute', assignments: [running] }))).toBe('running')
+  })
+})
