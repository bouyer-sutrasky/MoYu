+/**
+ * The processes below this harness in `/proc`, for stop evidence: PID, parent PID and a truncated command line.
+ * A pause records the tree before stopping and after the worker is idle, so a leftover shell or child is visible.
+ */
+export function processTree(root = process.pid, limit = 20): { pid: number; ppid: number; command: string }[] {
+  const nodes: { pid: number; ppid: number; command: string }[] = []
+  try {
+    for (const name of readdirSync('/proc')) {
+      if (!/^\d+$/.test(name)) continue
+      const pid = Number(name)
+      try {
+        const stat = readFileSync(`/proc/${pid}/stat`, 'utf8')
+        const ppid = Number(stat.slice(stat.lastIndexOf(')') + 2).split(' ')[1])
+        const command = readFileSync(`/proc/${pid}/cmdline`, 'utf8').split('\0').filter(Boolean).join(' ').slice(0, 160)
+        nodes.push({ pid, ppid, command })
+      } catch { /* the process exited while it was read */ }
+    }
+    const byParent = new Map<number, typeof nodes>()
+    for (const node of nodes) byParent.set(node.ppid, [...byParent.get(node.ppid) ?? [], node])
+    const found: typeof nodes = []
+    const queue = [root]
+    const seen = new Set([root])
+    while (queue.length) {
+      for (const child of byParent.get(queue.shift()!) ?? []) {
+        if (seen.has(child.pid)) continue
+        seen.add(child.pid); found.push(child); queue.push(child.pid)
+      }
+    }
+    return found.sort((a, b) => a.pid - b.pid).slice(0, limit)
+  } catch { return [] }
+}
