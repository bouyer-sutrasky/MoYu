diff --git a/tests/process-tree.spec.ts b/tests/process-tree.spec.ts
new file mode 100644
index 0000000..9539a8f
--- /dev/null
+++ b/tests/process-tree.spec.ts
@@ -0,0 +1,18 @@
+import { spawn } from 'node:child_process'
+import { once } from 'node:events'
+import { expect, it, vi } from 'vitest'
+import { processTree } from '../src/executor/dsh.ts'
+
+it('records a live child PID and drops it once the process exits', async () => {
+  const child = spawn('sleep', ['30'], { stdio: 'ignore' })
+  try {
+    await vi.waitFor(() => expect(processTree().some(process => process.pid === child.pid)).toBe(true), { timeout: 5000 })
+    const found = processTree().find(process => process.pid === child.pid)!
+    expect(found.ppid).toBe(process.pid)
+    expect(found.command).toContain('sleep 30')
+  } finally {
+    child.kill('SIGKILL')
+    await once(child, 'exit')
+  }
+  await vi.waitFor(() => expect(processTree().some(process => process.pid === child.pid)).toBe(false), { timeout: 5000 })
+})
