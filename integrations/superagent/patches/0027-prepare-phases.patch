diff --git a/tests/prepare-progress.spec.ts b/tests/prepare-progress.spec.ts
new file mode 100644
index 0000000..b842be1
--- /dev/null
+++ b/tests/prepare-progress.spec.ts
@@ -0,0 +1,95 @@
+/**
+ * The owner has to be able to tell why a task is still "queued" and whether a
+ * worker ever started. These tests keep the Executor's prepare phase reporting:
+ * a successful checkout says the workspace is ready and the worker is starting,
+ * a failed one names the checkout phase and says no worker was started, so the
+ * platform's `task.progress` stream can explain it instead of a generic queue.
+ */
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { describe, expect, it, vi } from 'vitest'
+import type { Ticket } from '../src/core/index.ts'
+import { DshExecutor } from '../src/executor/dsh.ts'
+import { SettingsSchema } from '../src/policy.ts'
+
+const reader = (text: string) => ({ readFrom: () => ({ text, nextOffset: text.length, lossy: false }) })
+
+/** A subprocess whose runs answer in order; the second one is `verifyDirectory`'s git config call. */
+function subprocess(runs: { code: number; stdout?: string; stderr?: string }[]) {
+  return {
+    spawn: vi.fn(() => {
+      const run = runs.shift() ?? { code: 1 }
+      return {
+        done: Promise.resolve({ exitCode: run.code }),
+        collected: { stdout: reader(run.stdout ?? ''), stderr: reader(run.stderr ?? '') },
+      }
+    }),
+  }
+}
+
+function harness(runs: { code: number; stdout?: string; stderr?: string }[]) {
+  const root = mkdtempSync(join(tmpdir(), 'moyu-prepare-progress-'))
+  const progress: { ticketId: string; key: string; text: string }[] = []
+  const host = {
+    context: { subprocess: subprocess(runs) },
+    store: {
+      settings: () => SettingsSchema.parse({ executor: { prepare: 'git clone' } }),
+      tickets: { open: () => [] },
+    },
+    effects: { handle: () => {} },
+    environment: () => [],
+    lifetime: new AbortController().signal,
+    progress: (ticketId: string, key: string, text: string) => progress.push({ ticketId, key, text }),
+    machine: { stateDir: root },
+  }
+  const executor = new DshExecutor(host as never)
+  const ticket = {
+    id: 't1',
+    assignments: [],
+    execution: { name: 'fix-t1', directory: join(root, 'worktree'), assignment: 'Fix it' },
+  } as unknown as Ticket
+  const prepare = () =>
+    (executor as unknown as { prepareDirectory(ticket: Ticket): Promise<void> }).prepareDirectory(ticket)
+  return { root, progress, prepare, done: () => rmSync(root, { recursive: true, force: true }) }
+}
+
+describe('the Executor checkout phase reported to the Bridge', () => {
+  it('reports the checkout start and ready phases before starting the worker', async () => {
+    const h = harness([{ code: 0 }, { code: 1 }])
+    try {
+      await h.prepare()
+      expect(h.progress.map(item => item.key.replace(/^none:/, ''))).toEqual(['prepare-start', 'prepare-ready'])
+      expect(h.progress[0]?.text).toContain('准备任务工作区')
+      expect(h.progress[1]?.text).toContain('正在启动 worker')
+    } finally {
+      h.done()
+    }
+  })
+
+  it('names the phase and says the worker never started when the checkout fails', async () => {
+    const h = harness([{ code: 128, stderr: 'fatal: could not fetch the frozen commit' }])
+    try {
+      await expect(h.prepare()).rejects.toThrow('The prepare command failed')
+      expect(h.progress).toHaveLength(2)
+      expect(h.progress[1]?.key).toMatch(/:prepare-failed$/)
+      expect(h.progress[1]?.text).toContain('阶段：检出工作区')
+      expect(h.progress[1]?.text).toContain('worker 未启动')
+      expect(h.progress[1]?.text).toContain('fatal: could not fetch the frozen commit')
+    } finally {
+      h.done()
+    }
+  })
+
+  it('says the worker never started when the prepared workspace fails verification', async () => {
+    const h = harness([{ code: 0 }, { code: 0, stdout: 'local\0credential.helper=leak\0' }])
+    try {
+      await expect(h.prepare()).rejects.toThrow('The prepare command failed')
+      expect(h.progress.at(-1)?.key).toMatch(/:prepare-failed$/)
+      expect(h.progress.at(-1)?.text).toContain('阶段：核对工作区')
+      expect(h.progress.at(-1)?.text).toContain('worker 未启动')
+    } finally {
+      h.done()
+    }
+  })
+})
