diff --git a/tests/ticket-freeze.spec.ts b/tests/ticket-freeze.spec.ts
new file mode 100644
index 0000000..b821010
--- /dev/null
+++ b/tests/ticket-freeze.spec.ts
@@ -0,0 +1,115 @@
+import { describe, expect, it, vi } from 'vitest'
+import { Engine, MemoryRepositories, frozenSpec, type Assessor, type Candidate, type Executor, type Outbox, type Policy, type Ticket, type Trigger }
+  from '../src/core/index.ts'
+import { verifyTicketModel } from '../src/app/role-models.ts'
+
+const MODEL = { provider: 'commandcode', model: 'deepseek/deepseek-v4.1-flash', reasoningEffort: 'high' }
+const SPEC = { repository: 'acme/widgets', baseBranch: 'main', baseCommit: 'abc123', model: MODEL, mode: 'execute', modelSource: 'spec' }
+const trigger = (overrides: Partial<Trigger> = {}): Trigger => ({
+  id: 'workspace:m1', source: 'workspace', threads: [{ source: 'workspace', id: 'workspace:c1' }],
+  actor: { source: 'workspace', id: 'owner' }, human: true, addressed: 'direct', at: '2026-11-03T12:00:00.000Z', text: 'Fix the margin',
+  channel: { source: 'workspace', thread: 'workspace:c1', address: { conversationId: 'c1' } },
+  meta: { conversationId: 'c1', messageId: 'm1', triggerId: 'workspace:m1', spec: SPEC }, ...overrides,
+})
+
+/** Minimal Engine whose Policy admits every human message explicitly, so a ticket is created synchronously. */
+function harness() {
+  const repo = new MemoryRepositories()
+  const requests: Candidate[] = []
+  const assessor: Assessor = { request: candidate => { requests.push(candidate) } }
+  const executor: Executor = { start: () => {}, deliver: () => {}, stop: () => {} }
+  const outbox: Outbox = { send: () => {}, status: () => undefined, withdraw: () => {} }
+  const policy: Policy = { version: 'v1', paused: false, evalTimeoutMs: 60_000,
+    gate: () => ({ admissible: true, strength: 'explicit', basis: { via: 'listed' } }), revalidate: () => true, admitsInferred: () => true }
+  const engine = new Engine({ repo, scope: { scope: () => ({ listened: true, observed: false, row: 'web' }) }, policy: () => policy,
+    assessor, executor, outbox })
+  /** Accepts the newest candidate and returns the ticket it created. */
+  const accept = (): Ticket => {
+    const candidate = requests.at(-1)
+    if (!candidate) throw new Error('no candidate')
+    engine.decide(candidate.triggers[0]!.id, { evalId: candidate.evalId, kind: 'accept', title: 'Fix the margin', scope: 'small', reason: 'asked' })
+    return repo.tickets.list()[0]!
+  }
+  return { repo, engine, requests, accept }
+}
+
+describe('frozenSpec', () => {
+  it('reads a complete execute spec from a workspace Trigger', () => {
+    expect(frozenSpec(trigger())).toEqual(SPEC)
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, model: { provider: 'p', model: 'm' }, modelSource: 'executor' } } })))
+      .toEqual({ ...SPEC, model: { provider: 'p', model: 'm' }, modelSource: 'executor' })
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, model: null, modelSource: 'instance' } } })))
+      .toEqual({ ...SPEC, model: null, modelSource: 'instance' })
+  })
+
+  it('refuses anything it would have to guess', () => {
+    expect(frozenSpec(undefined)).toBeUndefined()
+    expect(frozenSpec(trigger({ source: 'github' }))).toBeUndefined()
+    expect(frozenSpec(trigger({ meta: {} }))).toBeUndefined()
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, baseCommit: '' } } }))).toBeUndefined()
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, repository: '' } } }))).toBeUndefined()
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, baseBranch: undefined } } }))).toBeUndefined()
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, model: { provider: 'p' } } } }))).toBeUndefined()
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, model: { provider: 'p', model: 'm', reasoningEffort: 3 } } } }))).toBeUndefined()
+    // A null model means the instance default, and a resolved model must not claim to be one.
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, model: null } } }))).toBeUndefined()
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, model: null, modelSource: 'spec' } } }))).toBeUndefined()
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, modelSource: 'instance' } } }))).toBeUndefined()
+    // Only execute reaches a ticket; discuss is refused by the Bridge.
+    expect(frozenSpec(trigger({ meta: { spec: { ...SPEC, mode: 'discuss' } } }))).toBeUndefined()
+  })
+})
+
+describe('Ticket freeze at acceptance', () => {
+  it('copies the model, base, and mode onto the ticket the workspace Trigger created', () => {
+    const h = harness()
+    h.engine.receive(trigger())
+    h.engine.evaluateDue()
+    const ticket = h.accept()
+    expect(ticket.model).toEqual(MODEL)
+    expect(ticket.base).toEqual({ repository: 'acme/widgets', branch: 'main', commit: 'abc123' })
+    expect(ticket.mode).toBe('execute')
+    expect(ticket.modelSource).toBe('spec')
+  })
+
+  it('records the model the instance froze when the platform named none, and the instance default when there was none', () => {
+    const h = harness()
+    h.engine.receive(trigger({ meta: { ...trigger().meta, spec: { ...SPEC, model: MODEL, modelSource: 'executor' } } }))
+    h.engine.evaluateDue()
+    expect(h.accept()).toMatchObject({ model: MODEL, modelSource: 'executor' })
+
+    const other = harness()
+    other.engine.receive(trigger({ meta: { ...trigger().meta, spec: { ...SPEC, model: null, modelSource: 'instance' } } }))
+    other.engine.evaluateDue()
+    const ticket = other.accept()
+    expect(ticket.model).toBeNull()
+    expect(ticket.modelSource).toBe('instance')
+  })
+
+  it('leaves a ticket from another Source without a frozen model (no guessed backfill)', () => {
+    const h = harness()
+    h.engine.receive(trigger({ id: 'github:1', source: 'github', threads: [{ source: 'github', id: 'github:1' }],
+      actor: { source: 'github', id: 'alice' }, meta: { number: 1 } }))
+    h.engine.evaluateDue()
+    const ticket = h.accept()
+    expect(ticket.model).toBeUndefined()
+    expect(ticket.base).toBeUndefined()
+    expect(ticket.mode).toBeUndefined()
+  })
+})
+
+describe('verifyTicketModel', () => {
+  it('resolves the frozen route through the live provider', async () => {
+    const resolveCallConfig = vi.fn(async (selection: { provider: string; model: string; reasoningEffort?: unknown }) =>
+      ({ provider: selection.provider, model: selection.model, reasoningEffort: selection.reasoningEffort }))
+    const ctx = { llm: { resolveCallConfig } }
+    await expect(verifyTicketModel(ctx as never, MODEL)).resolves.toMatchObject({ provider: 'commandcode', model: 'deepseek/deepseek-v4.1-flash' })
+    expect(resolveCallConfig).toHaveBeenCalledWith({ provider: 'commandcode', model: 'deepseek/deepseek-v4.1-flash', reasoningEffort: 'high' })
+  })
+
+  it('throws with the frozen identity instead of falling back to the instance default', async () => {
+    const ctx = { llm: { resolveCallConfig: vi.fn(async () => { throw new Error('unknown provider route') }) } }
+    await expect(verifyTicketModel(ctx as never, MODEL)).rejects.toThrow(/commandcode\/deepseek\/deepseek-v4\.1-flash is unavailable: unknown provider route/)
+    expect(ctx.llm.resolveCallConfig).toHaveBeenCalledTimes(1)
+  })
+})
