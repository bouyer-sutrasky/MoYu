+/** How a frozen model was chosen: the delivered spec, the instance's Executor setting, or the instance default (no model representable). */
+export type TicketModelSource = 'spec' | 'executor' | 'instance'
+/**
+ * The execution spec a workspace Trigger carried in `meta.spec`, as the machine Bridge froze it. `model` is null when the
+ * platform asked for the instance default and the instance had no Executor model to freeze either; `modelSource` records that.
+ */
+export interface TicketSpec { repository: string; baseBranch: string; baseCommit: string; model: TicketModel | null; mode: 'execute'
+  modelSource: TicketModelSource }
+/**
+ * Reads the frozen execution spec of a workspace Trigger, or undefined when it is missing or invalid. Only the workspace
+ * Source carries one; a ticket accepted from another Source keeps none and runs on the instance's role defaults.
+ */
+export function frozenSpec(trigger: Pick<Trigger, 'source' | 'meta'> | undefined): TicketSpec | undefined {
+  if (!trigger || trigger.source !== 'workspace') return undefined
+  const spec = trigger.meta.spec
+  if (!spec || typeof spec !== 'object') return undefined
+  const record = spec as Record<string, unknown>
+  const model = record.model
+  // A missing model is not a frozen choice; an explicit null records the instance default.
+  if (model === undefined || (model !== null && typeof model !== 'object')) return undefined
+  const { repository, baseBranch, baseCommit, mode, modelSource: source } = record
+  if (typeof repository !== 'string' || !repository) return undefined
+  if (typeof baseBranch !== 'string' || !baseBranch) return undefined
+  if (typeof baseCommit !== 'string' || !baseCommit) return undefined
+  // `discuss` never reaches a ticket: the Bridge refuses it before intake.
+  if (mode !== 'execute') return undefined
+  if (source !== undefined && source !== 'spec' && source !== 'executor' && source !== 'instance') return undefined
+  let frozen: TicketModel | null
+  if (model === null) {
+    frozen = null
+    if (source !== undefined && source !== 'instance') return undefined
+  } else {
+    const { provider, model: name, reasoningEffort } = model as Record<string, unknown>
+    if (typeof provider !== 'string' || !provider || typeof name !== 'string' || !name) return undefined
+    if (reasoningEffort !== undefined && typeof reasoningEffort !== 'string') return undefined
+    frozen = { provider, model: name, ...reasoningEffort ? { reasoningEffort } : {} }
+    if (source === 'instance') return undefined
+  }
+  return { repository, baseBranch, baseCommit, mode, model: frozen, modelSource: source ?? (frozen ? 'spec' : 'instance') }
+}
