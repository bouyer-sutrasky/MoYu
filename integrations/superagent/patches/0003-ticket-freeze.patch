+/** The model a ticket was accepted with, frozen for its worker; the same shape as the Policy's role model, defined here to keep core independent of it. */
+export interface TicketModel { provider: string; model: string; reasoningEffort?: string }
+/** The repository and starting commit a workspace ticket was accepted on. */
