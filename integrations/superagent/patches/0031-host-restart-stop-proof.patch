+/** The process identities currently in this runtime's instance cgroup, or null when it cannot be read. */
+export function instanceCgroupMembers(): ProcessIdentity[] | null {
+  try {
+    const line = readFileSync('/proc/self/cgroup', 'utf8').split('\n').find(item => item.startsWith('0::'))
+    const path = line?.slice(3).trim() ?? ''
+    if (!path || path === '/') return null
+    const pids = readFileSync(`/sys/fs/cgroup${path}/cgroup.procs`, 'utf8').trim().split('\n')
+      .filter(Boolean).map(Number).filter(Number.isFinite).filter(pid => pid !== process.pid)
+    return pids.map(pid => readProcessIdentity(pid)).filter((identity): identity is ProcessIdentity => identity !== null)
+  } catch { return null }
+}
+
+/**
+ * Whether a restarted host can prove that the previous host's worker turns are gone.
+ * The supervisor starts a new runtime only in an instance cgroup with no surviving
+ * member of the previous host. A member that started before this host is such a
+ * survivor; a member that started after it is this host's own child. Unreadable
+ * membership or an unknown start time is unknown and never proves a stop.
+ */
+export function hostRestartProof(self: ProcessIdentity, members: ProcessIdentity[]): boolean {
+  if (self.startTime === 'unknown' || !Number.isFinite(Number(self.startTime))) return false
+  const selfStart = Number(self.startTime)
+  return members.every(member => member.startTime !== 'unknown'
+    && Number.isFinite(Number(member.startTime)) && Number(member.startTime) > selfStart)
+}
+
+/** {@link hostRestartProof} over the runtime's own instance cgroup. */
+export function hostRestartProven(): boolean {
+  const self = readProcessIdentity(process.pid)
+  const members = instanceCgroupMembers()
+  return self !== null && members !== null && hostRestartProof(self, members)
+}
