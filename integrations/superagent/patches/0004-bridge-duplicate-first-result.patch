 /** Builds the stable workspace Trigger the Router delivers; the resolved `baseCommit` replaces the request's. */
+/** The base commit a stored workspace Trigger froze; null only for legacy rows without a spec. */
+function storedSpecBase(trigger: Trigger | undefined): string | null {
+  const spec = trigger?.meta.spec
+  if (!spec || typeof spec !== 'object') return null
+  const commit = (spec as Record<string, unknown>).baseCommit
+  return typeof commit === 'string' && commit ? commit : null
+}
