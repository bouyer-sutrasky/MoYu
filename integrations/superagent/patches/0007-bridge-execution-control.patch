@@ -0,0 +1,102 @@
+/**
+ * Append-only log of machine operations (pause, resume, start, retry) under `<stateDir>/bridge/operations.jsonl`, the same
+ * durability style as the Bridge event log: every transition is a full record written and fsynced before it is readable, the
+ * latest record per operation id wins on reopen, and a truncated final line from a crash is dropped. An operation stays
+ * queryable across a Bridge restart, and its state is only moved forward by `Bridge` from the Ticket's authoritative state.
+ */
+import { closeSync, fsyncSync, mkdirSync, openSync, readFileSync, writeFileSync, writeSync } from 'node:fs'
+import { dirname } from 'node:path'
+
+/** What a machine operation asks for; each maps to one operation of the Engine's `EngineForPeople` surface. */
+export type OperationKind = 'pause' | 'resume' | 'start' | 'retry'
+/** A queued operation waits for the Bridge tick; a running one waits for the Ticket to show its result. */
+export type OperationState = 'queued' | 'running' | 'succeeded' | 'failed'
+/** What the Ticket looked like when the operation was queued, which is how settlement tells a new Assignment from the old one. */
+export interface OperationBaseline {
+  assignmentId?: string
+  mode?: 'execute' | 'discuss'
+  planRevision?: number
+  paused?: { at: string; stoppedAt?: string }
+}
+/** One operation record as stored; every transition appends the whole record again. */
+export interface BridgeOperation {
+  operationId: string
+  ticketId: string
+  kind: OperationKind
+  state: OperationState
+  error?: string
+  evidence?: Record<string, unknown>
+  updatedAt: string
+  baseline?: OperationBaseline
+}
+/** The public shape of `GET /bridge/v1/operations/:id`; `baseline` is bookkeeping and not returned. */
+export interface OperationView {
+  operationId: string
+  ticketId: string
+  kind: OperationKind
+  state: OperationState
+  error?: string
+  evidence?: Record<string, unknown>
+  updatedAt: string
+}
+
+/** The view of an operation the Bridge returns to the platform. */
+export const operationView = (operation: BridgeOperation): OperationView => ({
+  operationId: operation.operationId, ticketId: operation.ticketId, kind: operation.kind, state: operation.state, updatedAt: operation.updatedAt,
+  ...operation.error === undefined ? {} : { error: operation.error },
+  ...operation.evidence === undefined ? {} : { evidence: operation.evidence },
+})
+
+/** The append-only machine-operation log: fsynced records, latest state per operation id, and the pending ones to settle. */
+export class OperationLog {
+  private fd: number | undefined
+  private readonly records = new Map<string, BridgeOperation>()
+  constructor(readonly file: string) {}
+
+  /** Reads the existing log, repairs a truncated final line, keeps the latest record per id, and opens it for appending. */
+  open(): void {
+    if (this.fd !== undefined) return
+    mkdirSync(dirname(this.file), { recursive: true, mode: 0o700 })
+    let text = ''
+    try { text = readFileSync(this.file, 'utf8') }
+    catch (error) { if ((error as { code?: string }).code !== 'ENOENT') throw error }
+    if (text && !text.endsWith('\n')) {
+      // Drop a partial trailing line: it was never fsynced, cannot be parsed, and appending after it would corrupt the file.
+      text = text.slice(0, text.lastIndexOf('\n') + 1)
+      writeFileSync(this.file, text, { mode: 0o600 })
+    }
+    for (const line of text.split('\n')) {
+      if (!line) continue
+      let record: BridgeOperation
+      try { record = JSON.parse(line) as BridgeOperation } catch { continue }
+      if (!record || typeof record.operationId !== 'string' || typeof record.ticketId !== 'string' || typeof record.kind !== 'string') continue
+      this.records.set(record.operationId, record)
+    }
+    this.fd = openSync(this.file, 'a', 0o600)
+  }
+
+  /** Appends a whole record and fsyncs it before returning, so the platform can read it right after the 202. */
+  append(operation: BridgeOperation): BridgeOperation {
+    if (this.fd === undefined) throw new Error('The bridge operation log is not open')
+    writeSync(this.fd, `${JSON.stringify(operation)}\n`)
+    fsyncSync(this.fd)
+    this.records.set(operation.operationId, operation)
+    return operation
+  }
+
+  /** Appends a new state of an existing operation; undefined when the id is unknown. */
+  update(operationId: string, patch: Partial<Omit<BridgeOperation, 'operationId' | 'ticketId' | 'kind'>>, at: string): BridgeOperation | undefined {
+    const current = this.records.get(operationId)
+    if (!current) return undefined
+    return this.append({ ...current, ...patch, operationId: current.operationId, ticketId: current.ticketId, kind: current.kind, updatedAt: at })
+  }
+
+  get(operationId: string): BridgeOperation | undefined { return this.records.get(operationId) }
+  /** Operations that still wait for the Ticket to show their result, oldest first. */
+  pending(): BridgeOperation[] { return [...this.records.values()].filter(item => item.state === 'queued' || item.state === 'running') }
+  close(): void {
+    if (this.fd === undefined) return
+    closeSync(this.fd)
+    this.fd = undefined
+  }
+}
