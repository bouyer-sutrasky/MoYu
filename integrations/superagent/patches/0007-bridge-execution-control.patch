+
+const workspaceTrigger = (id = 'workspace:m1'): Trigger => ({
+  id, source: 'workspace', threads: [{ source: 'workspace', id: 'workspace:c1' }], actor: { source: 'workspace', id: 'owner' },
+  human: true, addressed: 'direct', at: '2026-11-03T12:00:00.000Z', text: 'Fix the margin',
+  channel: { source: 'workspace', thread: 'workspace:c1', address: { conversationId: 'c1' } },
+  meta: { conversationId: 'c1', messageId: 'm1', triggerId: id, spec: {} },
+})
+const githubTrigger = (number = 7): Trigger => ({
+  id: `github-comment:${number}`, source: 'github', threads: [{ source: 'github', id: String(number) }],
+  actor: { source: 'github', id: 'alice' }, human: true, at: '2026-11-03T11:00:00.000Z', text: 'Please fix it',
+  channel: { source: 'github', thread: `github:${number}`, address: { number: String(number) } }, meta: { number, isPr: true, kind: 'conversation' },
+})
+
+const ticket = (id: string, overrides: Partial<Ticket> = {}): Ticket => ({
+  id, title: `Fix ${id}`, decisionId: 'd1',
+  mandate: { strength: 'explicit', policyVersion: 'v1', basis: { via: 'listed' }, actor: { source: 'workspace', id: 'owner' }, scope: 'web' },
+  channels: [{ source: 'workspace', thread: 'workspace:c1', address: { conversationId: 'c1' } }],
+  assignments: [], inputs: [], undelivered: [], createdAt: '2026-11-03T12:00:00.000Z', updatedAt: '2026-11-03T12:00:00.000Z',
+  origin: { triggerId: 'workspace:m1', triggerIds: ['workspace:m1'] }, ...overrides,
