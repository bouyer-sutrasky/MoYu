+function harness(overrides: Partial<BridgeHost> = {}): ControlHarness {
+  const repo = new MemoryRepositories()
+  const received: Trigger[] = []
+  const commands = { api: vi.fn(async () => ({ sha: 'branch-sha' })) }
+  const addAssignment = (t: Ticket, reason?: string) => {
