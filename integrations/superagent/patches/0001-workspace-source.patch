new file mode 100644
index 0000000..90f3b97
--- /dev/null
+++ b/tests/workspace.spec.ts
@@ -0,0 +1,151 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from 'node:http'
+import { apply, messageKindOf, repliedTriggerId, sendWorkspace, WorkspaceConfigSchema, workspaceAddress, workspaceKind,
+  workspaceThreadContext } from '../src/sources/workspace.ts'
+import type { OutboundMessage, Trigger } from '../src/core/index.ts'
+import { testDeployment } from './fixtures/deployment.ts'
+
+/** A workspace Trigger as the Bridge builds it (`src/app/bridge.ts`). */
+function trigger(overrides: Partial<Trigger> = {}): Trigger {
+  return {
+    id: 'workspace:m1', source: 'workspace', threads: [{ source: 'workspace', id: 'workspace:c1' }],
+    actor: { source: 'workspace', id: '11111111-2222-3333-4444-555555555555' }, human: true, addressed: 'direct',
+    at: '2026-11-03T12:00:00.000Z', text: 'Fix the margin', channel: { source: 'workspace', thread: 'workspace:c1', address: { conversationId: 'c1', messageId: 'm1' } },
+    meta: { conversationId: 'c1', messageId: 'm1', replyToMessageId: 'm0', triggerId: 'workspace:m1', parentText: 'The earlier message',
+      spec: { repository: 'acme/widgets', baseBranch: 'main', baseCommit: 'abc123', model: { provider: 'commandcode', model: 'deepseek/deepseek-v4.1-flash', reasoningEffort: 'high' }, mode: 'execute' } },
+    ...overrides,
+  }
+}
+const message = (id: string, overrides: Partial<OutboundMessage> = {}): OutboundMessage => ({
+  id, channel: { source: 'workspace', thread: 'workspace:c1', address: { conversationId: 'c1', messageId: 'm1' } },
+  text: 'On it', kind: 'reply', ticketId: 't1', ...overrides })
+
+const servers: Server[] = []
+afterEach(async () => {
+  await Promise.all(servers.splice(0).map(server => new Promise<void>(resolve => { server.close(() => resolve()) })))
+  vi.unstubAllEnvs()
+})
+/** Starts a platform stand-in on a loopback port and returns its origin plus the requests it received. */
+async function platform(answer: (req: IncomingMessage, res: ServerResponse) => void): Promise<{ url: string; requests: { headers: IncomingMessage['headers']; body: Record<string, unknown> }[] }> {
+  const requests: { headers: IncomingMessage['headers']; body: Record<string, unknown> }[] = []
+  const server = createServer(async (req, res) => {
+    const chunks: Buffer[] = []
+    for await (const chunk of req) chunks.push(Buffer.from(chunk))
+    requests.push({ headers: req.headers, body: JSON.parse(Buffer.concat(chunks).toString('utf8')) as Record<string, unknown> })
+    answer(req, res)
+  })
+  servers.push(server)
+  await new Promise<void>(resolve => { server.listen(0, '127.0.0.1', () => { resolve() }) })
+  const address = server.address()
+  if (!address || typeof address === 'string') throw new Error('no port')
+  return { url: `http://127.0.0.1:${address.port}`, requests }
+}
+const answer = (status: number) => (_req: IncomingMessage, res: ServerResponse) => { res.writeHead(status); res.end('{}') }
+const configure = (url: string) => { vi.stubEnv('MOYU_PLATFORM_URL', url); vi.stubEnv('MOYU_PLATFORM_TOKEN', 'platform-token') }
+
+describe('the workspace Source kind', () => {
+  it('stores only non-secret configuration and listens to every delivered message', () => {
+    expect(WorkspaceConfigSchema.parse({})).toEqual({ repository: '' })
+    expect(WorkspaceConfigSchema.parse({ repository: 'acme/widgets' })).toEqual({ repository: 'acme/widgets' })
+    expect(() => WorkspaceConfigSchema.parse({ token: 'secret' })).toThrow()
+    expect(workspaceKind.kind).toBe('workspace')
+    expect(workspaceKind.health).toEqual(['workspace'])
+    expect(workspaceKind.scope!({ meta: {} }, { repository: '' })).toEqual({ listened: true, observed: false, row: 'web' })
+    expect(workspaceKind.fields.map(field => field.key)).toEqual(['repository'])
+    const policy = workspaceKind.policy!
+    expect(policy.schema.parse({ allowed: [{ id: '11111111-2222-3333-4444-555555555555' }] }))
+      .toEqual({ allowed: [{ id: '11111111-2222-3333-4444-555555555555' }] })
+    expect(policy.schema.parse({})).toEqual({ allowed: [] })
+    expect(policy.fields[0]!.key).toBe('allowed')
+    expect('bots' in policy).toBe(false)
+  })
+
+  it('registers the kind and reports health from the plugin entry, without owning the Bridge', () => {
+    const registered: unknown[] = []
+    const report = vi.fn()
+    const effect = vi.fn((run: () => () => void) => { run(); return () => {} })
+    const ctx = { orchestrator: { sources: { register: (kind: unknown) => { registered.push(kind); return () => {} } },
+      context: () => ({ report }) }, effect }
+    apply(ctx as never)
+    expect(registered).toEqual([workspaceKind])
+    expect(report).toHaveBeenCalledWith('workspace', expect.objectContaining({ state: 'ready' }))
+  })
+
+  it('reads one page with the Trigger message and the replied-to message it was given, inventing nothing', async () => {
+    const commands = {} as never
+    expect(workspaceThreadContext.messageId(trigger())).toBe('m1')
+    const thread = await workspaceThreadContext.read(commands, trigger(), 'thread', undefined, { repository: '' })
+    expect(thread).toMatchObject({ messages: [{ id: 'm1', from: '11111111-2222-3333-4444-555555555555', at: '2026-11-03T12:00:00.000Z', text: 'Fix the margin' }], body: {} })
+    expect(thread.next).toBeUndefined()
+    expect(await workspaceThreadContext.read(commands, trigger(), 'root', undefined, { repository: '' })).toEqual(thread)
+    expect((await workspaceThreadContext.read(commands, trigger(), 'parent', undefined, { repository: '' })).messages)
+      .toEqual([{ id: 'm0', from: '11111111-2222-3333-4444-555555555555', at: '2026-11-03T12:00:00.000Z', text: 'The earlier message' }])
+    const orphan = trigger({ meta: { conversationId: 'c1', messageId: 'm1', spec: {} } })
+    expect(await workspaceThreadContext.read(commands, orphan, 'parent', undefined, { repository: '' })).toEqual({ messages: [], body: {} })
+  })
+
+  it('publishes the frozen execution spec in its environment, never credentials', () => {
+    const deployment = testDeployment()
+    const values = workspaceKind.environment!.values({ deployment, config: { repository: '' }, trigger: trigger() })
+    expect(values).toEqual({
+      DSH_SUPERAGENT_WORKSPACE_REPOSITORY: 'acme/widgets',
+      DSH_SUPERAGENT_WORKSPACE_ACCOUNT: 'agent-bot',
+      DSH_SUPERAGENT_WORKSPACE_COMMIT_EMAIL: '7+agent-bot@users.noreply.github.com',
+      DSH_SUPERAGENT_WORKSPACE_BASE_BRANCH: 'main',
+      DSH_SUPERAGENT_WORKSPACE_BASE_COMMIT: 'abc123',
+      DSH_SUPERAGENT_WORKSPACE_MODEL: 'commandcode/deepseek/deepseek-v4.1-flash',
+      DSH_SUPERAGENT_WORKSPACE_CONVERSATION: 'c1',
+    })
+    expect(Object.keys(values).some(key => /TOKEN|KEY|SECRET/i.test(key))).toBe(false)
+    // Without a Trigger the deployment repository and empty frozen values stand in, so a prepare command still runs.
+    expect(workspaceKind.environment!.values({ deployment, config: { repository: '' } }))
+      .toMatchObject({ DSH_SUPERAGENT_WORKSPACE_REPOSITORY: 'acme/widgets', DSH_SUPERAGENT_WORKSPACE_BASE_BRANCH: '',
+        DSH_SUPERAGENT_WORKSPACE_BASE_COMMIT: '', DSH_SUPERAGENT_WORKSPACE_MODEL: '', DSH_SUPERAGENT_WORKSPACE_CONVERSATION: '' })
+  })
+
+  it('derives address, message kind and answered Trigger from the message id', () => {
+    expect(workspaceAddress(trigger())).toEqual({ conversationId: 'c1', messageId: 'm1' })
+    expect(messageKindOf({ id: 'ack:workspace:m1', kind: 'acknowledgement' })).toBe('acknowledgement')
+    expect(messageKindOf({ id: 'attention-reply:abc', kind: 'reply' })).toBe('question')
+    expect(messageKindOf({ id: 'abc', kind: 'notice' })).toBe('notice')
+    expect(messageKindOf({ id: 'abc', kind: 'reply' })).toBe('reply')
+    expect(repliedTriggerId('ack:workspace:m1')).toBe('workspace:m1')
+    expect(repliedTriggerId('attention-reply:abc')).toBeUndefined()
+    expect(repliedTriggerId('abc')).toBeUndefined()
+  })
+})
+
+describe('the workspace Channel', () => {
+  it('posts the machine body and confirms only after a 2xx', async () => {
+    const { url, requests } = await platform(answer(200))
+    configure(url)
+    await expect(workspaceKind.channel!.send({ commands: {} as never }, message('ack:workspace:m1', { kind: 'acknowledgement' }))).resolves.toBe('sent')
+    expect(requests[0]!.headers.authorization).toBe('Bearer platform-token')
+    expect(requests[0]!.headers['content-type']).toBe('application/json')
+    expect(requests[0]!.body).toMatchObject({ sourceEventId: 'ack:workspace:m1', type: 'channel.message', conversationId: 'c1',
+      ticketId: 't1', triggerId: 'workspace:m1', messageKind: 'acknowledgement', text: 'On it' })
+    expect(Date.parse(String(requests[0]!.body.at))).not.toBeNaN()
+  })
+
+  it('settles a permanent rejection as gone and retries a passing one', async () => {
+    configure((await platform(answer(404))).url)
+    await expect(sendWorkspace(message('reply-1'))).resolves.toBe('gone')
+    configure((await platform(answer(400))).url)
+    await expect(sendWorkspace(message('reply-2'))).resolves.toBe('gone')
+    for (const status of [408, 429, 500, 503]) {
+      configure((await platform(answer(status))).url)
+      await expect(sendWorkspace(message(`reply-${status}`))).rejects.toThrow(String(status))
+    }
+  })
+
+  it('throws while the platform is unreachable or unconfigured', async () => {
+    const { url } = await platform(answer(200))
+    configure(url)
+    servers.splice(0).forEach(server => server.close())
+    await expect(sendWorkspace(message('reply-offline'))).rejects.toThrow()
+    vi.unstubAllEnvs()
+    await expect(sendWorkspace(message('reply-unset'))).rejects.toThrow(/MOYU_PLATFORM_URL/)
+    vi.stubEnv('MOYU_PLATFORM_URL', 'http://127.0.0.1:1')
+    await expect(sendWorkspace(message('reply-token'))).rejects.toThrow(/MOYU_PLATFORM_TOKEN/)
+  })
+})
