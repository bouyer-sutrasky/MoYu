diff --git a/src/sources/workspace.ts b/src/sources/workspace.ts
new file mode 100644
index 0000000..b6f0943
--- /dev/null
+++ b/src/sources/workspace.ts
@@ -0,0 +1,238 @@
+/**
+ * Workspace Source: the MoYu platform's conversations, delivered by the machine Bridge (`src/app/bridge.ts`) as Triggers
+ * and answered through the platform's runtime-events callback.
+ *
+ * This kind owns no polling: the Bridge is part of the Runtime (it needs the Engine, the Store, and the model catalog), so
+ * the plugin here only registers the kind and reports its health. Replies go out over HTTP to the platform, which is the
+ * only writer of its own messages; the channel confirms a reply only after the platform committed it.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import { z } from 'zod'
+import type { OutboundMessage, Trigger } from '../core/index.ts'
+import type { ChannelLink, ChannelLinks, ContextPart, SourceChannel, SourceKind, ThreadContext } from './kind.ts'
+import { sourceContext, type SourceContext } from './host.ts'
+
+/** Source kind id; also the `source` of every Trigger and Channel this Source produces. */
+export const SOURCE = 'workspace'
+/** The one health entry this kind owns. */
+export const HEALTH = 'workspace'
+/** How long one runtime-events callback may take before the Outbox is told the send failed (and retries it). */
+export const CALLBACK_TIMEOUT_MS = 10_000
+/** The platform's machine endpoint for Channel messages. */
+const CALLBACK_PATH = '/api/internal/v1/runtime-events'
+
+/**
+ * Non-secret configuration only: the deployment names the repository, and the platform's URL and token are instance
+ * environment variables (`MOYU_PLATFORM_URL`, `MOYU_PLATFORM_TOKEN`), never stored in the Source settings.
+ */
+export const WorkspaceConfigSchema = z.object({
+  repository: z.string().trim().regex(/^([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+)?$/, 'owner/name').default(''),
+}).strict()
+export type WorkspaceConfig = z.infer<typeof WorkspaceConfigSchema>
+
+/** Shape of the `executionSpec` the Bridge froze into a workspace Trigger's `meta.spec`. */
+interface FrozenSpec { repository: string; baseBranch: string; baseCommit: string; provider: string; model: string; reasoningEffort: string; mode: string }
+
+/** Reads `trigger.meta.spec` tolerantly; unknown or missing fields come back as empty strings. */
+function frozenSpecOf(trigger: Trigger | undefined): FrozenSpec {
+  const empty: FrozenSpec = { repository: '', baseBranch: '', baseCommit: '', provider: '', model: '', reasoningEffort: '', mode: '' }
+  if (!trigger || trigger.source !== SOURCE) return empty
+  const spec = trigger.meta.spec
+  if (!spec || typeof spec !== 'object') return empty
+  const record = spec as Record<string, unknown>
+  const model = record.model && typeof record.model === 'object' ? record.model as Record<string, unknown> : {}
+  const text = (value: unknown): string => typeof value === 'string' ? value : ''
+  return { repository: text(record.repository), baseBranch: text(record.baseBranch), baseCommit: text(record.baseCommit),
+    provider: text(model.provider), model: text(model.model), reasoningEffort: text(model.reasoningEffort), mode: text(record.mode) }
+}
+
+/** `provider/model` as a human and prompt readable identifier; empty while the spec names no model. */
+export function workspaceModelLabel(trigger: Trigger | undefined): string {
+  const spec = frozenSpecOf(trigger)
+  return spec.provider && spec.model ? `${spec.provider}/${spec.model}` : ''
+}
+
+/** The conversation of a workspace Trigger, which is also its primary thread's suffix and its Channel address. */
+export function workspaceConversation(trigger: Trigger): string {
+  const fromMeta = trigger.meta.conversationId
+  if (typeof fromMeta === 'string' && fromMeta) return fromMeta
+  const address = trigger.channel?.address.conversationId
+  return typeof address === 'string' ? address : ''
+}
+
+/** The Channel address of one workspace conversation; `messageId` names the platform message a reply is for, when known. */
+export interface WorkspaceAddress { conversationId: string; messageId?: string }
+/** Builds the Channel address from a Trigger's metadata. */
+export function workspaceAddress(trigger: Pick<Trigger, 'meta' | 'channel'>): WorkspaceAddress {
+  const conversationId = typeof trigger.meta.conversationId === 'string' ? trigger.meta.conversationId
+    : trigger.channel?.address.conversationId ?? ''
+  return { conversationId, ...typeof trigger.meta.messageId === 'string' ? { messageId: trigger.meta.messageId } : {} }
+}
+
+/**
+ * The platform message kind of a queued outbound message. Acknowledgements and questions carry their purpose in the id
+ * prefix (`ack:` and `attention-reply:`, see `src/core/replies.ts`), which is also what tells the platform whether the
+ * reply answers a question; everything else is a `notice`, or an ordinary `reply`.
+ */
+export function messageKindOf(message: Pick<OutboundMessage, 'id' | 'kind'>): 'question' | 'acknowledgement' | 'notice' | 'reply' {
+  if (message.id.startsWith('attention-reply:')) return 'question'
+  if (message.id.startsWith('ack:')) return 'acknowledgement'
+  return message.kind === 'notice' ? 'notice' : 'reply'
+}
+
+/** The Trigger an outbound message answers, when its id names one (`ack:<triggerId>`); undefined otherwise. */
+export function repliedTriggerId(messageId: string): string | undefined {
+  const separator = messageId.indexOf(':')
+  if (separator < 0) return undefined
+  const suffix = messageId.slice(separator + 1)
+  return suffix.startsWith(`${SOURCE}:`) ? suffix : undefined
+}
+
+/** Reads the platform environment, or throws so the Outbox keeps the message pending and retries it. */
+function platformEnvironment(): { url: string; token: string } {
+  const url = (process.env.MOYU_PLATFORM_URL ?? '').replace(/\/+$/, '')
+  const token = process.env.MOYU_PLATFORM_TOKEN ?? ''
+  if (!url) throw new Error('MOYU_PLATFORM_URL is unset: the workspace Channel cannot reach the platform')
+  if (!token) throw new Error('MOYU_PLATFORM_TOKEN is unset: the workspace Channel cannot authenticate to the platform')
+  return { url, token }
+}
+
+/**
+ * Posts one Channel message to the platform's runtime-events endpoint.
+ * Returns `'sent'` only after a 2xx response; throws on network errors, timeouts, 408/429, and 5xx so the Outbox retries;
+ * returns `'gone'` only for a permanent 4xx (the conversation no longer accepts replies).
+ */
+export async function sendWorkspace(message: OutboundMessage): Promise<'sent' | 'gone'> {
+  const { url, token } = platformEnvironment()
+  const conversationId = message.channel.address.conversationId ?? ''
+  if (!conversationId) throw new Error('The workspace message has no conversation to reply to')
+  const triggerId = repliedTriggerId(message.id)
+  const body = JSON.stringify({
+    sourceEventId: message.id,
+    type: 'channel.message',
+    conversationId,
+    ticketId: message.ticketId ?? null,
+    ...triggerId ? { triggerId } : {},
+    messageKind: messageKindOf(message),
+    text: message.text,
+    at: new Date().toISOString(),
+  })
+  let response: Response
+  try {
+    response = await fetch(`${url}${CALLBACK_PATH}`, { method: 'POST', headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
+      body, signal: AbortSignal.timeout(CALLBACK_TIMEOUT_MS) })
+  } catch (error) {
+    // A timeout, a refused connection, or any other transport failure: the platform may still be starting, so retry later.
+    throw new Error(`The platform did not accept the workspace message: ${error instanceof Error ? error.message : String(error)}`, { cause: error })
+  }
+  if (response.ok) return 'sent'
+  // A permanent rejection of this conversation settles the receipt as gone; 408 and 429 are passing and retried.
+  if (response.status >= 400 && response.status < 500 && response.status !== 408 && response.status !== 429) return 'gone'
+  throw new Error(`The platform answered the workspace message with HTTP ${response.status}`)
+}
+
+/** Channel adapter for workspace conversations: replies are HTTP callbacks, and links have no platform URL yet. */
+export const workspaceChannel = {
+  async send(_host: Pick<SourceContext, 'commands'>, message: OutboundMessage): Promise<'sent' | 'gone'> {
+    return sendWorkspace(message)
+  },
+  link(_address: Record<string, string>, _links: ChannelLinks): ChannelLink {
+    return { url: '', label: { zh: 'MoYu 会话', en: 'MoYu conversation' } }
+  },
+} satisfies SourceChannel<WorkspaceConfig>
+
+/** The Trigger's own message id in its Thread, as the platform recorded it. */
+const messageIdOf = (trigger: Trigger): string => String(trigger.meta.messageId ?? '')
+/** The Trigger's replied-to message id, when the platform recorded one. */
+const parentIdOf = (trigger: Trigger): string => {
+  const parent = trigger.meta.replyToMessageId
+  return typeof parent === 'string' && parent ? parent : `${messageIdOf(trigger)}:parent`
+}
+const emptyPage = (): ContextPart => ({ messages: [], body: {} })
+
+/**
+ * Context of a workspace Trigger, which the platform already recorded: one page with the Trigger's own message, and the
+ * replied-to message when its text was delivered with the Trigger. Nothing else is invented: the platform serves the
+ * bounded conversation history itself and does not expect the worker to read it from here.
+ */
+export const workspaceThreadContext: ThreadContext<WorkspaceConfig> = {
+  messageId: trigger => messageIdOf(trigger),
+  async read(_commands, trigger, part): Promise<ContextPart> {
+    if (part === 'parent') {
+      const text = trigger.meta.parentText
+      if (typeof text !== 'string' || !text) return emptyPage()
+      return { messages: [{ id: parentIdOf(trigger), from: trigger.actor.id, at: trigger.at, text }], body: {} }
+    }
+    const id = messageIdOf(trigger)
+    if (!id) return emptyPage()
+    return { messages: [{ id, from: trigger.actor.id, at: trigger.at, text: trigger.text }], body: {} }
+  },
+}
+
+/**
+ * Workspace Source kind: the platform's conversations, admitted by the owner's account id from the Policy part. Every
+ * message it produces is addressed to the agent directly (`addressed: 'direct'` in `src/app/bridge.ts`), so it never needs
+ * an "observed" row.
+ */
+export const workspaceKind: SourceKind<WorkspaceConfig> = {
+  kind: SOURCE,
+  title: { zh: 'MoYu 工作区', en: 'MoYu workspace' },
+  description: { zh: 'MoYu 平台里的会话。机器 Bridge 把平台消息变成触发，回复通过平台的 runtime-events 回调写回会话。',
+    en: 'Conversations in the MoYu platform. The machine Bridge turns platform messages into Triggers, and replies go back through the platform\'s runtime-events callback.' },
+  schema: WorkspaceConfigSchema,
+  fields: [
+    { key: 'repository', type: 'text', pattern: '[A-Za-z0-9_.\\-]+/[A-Za-z0-9_.\\-]+', label: { zh: '工作区仓库', en: 'Workspace repository' },
+      hint: { zh: '写作 owner/name。平台投递的 executionSpec.repository 必须与实例部署的仓库一致，否则 Bridge 返回 409。留空则沿用部署仓库。',
+        en: 'Written owner/name. A delivered executionSpec.repository must equal the deployment\'s repository or the Bridge answers 409. Empty uses the deployment repository.' } },
+  ],
+  health: [HEALTH],
+  // Every delivered workspace message is addressed to the agent, and the Source has no unaddressed scope to observe.
+  scope: () => ({ listened: true, observed: false, row: 'web' }),
+  channel: workspaceChannel,
+  threadContext: workspaceThreadContext,
+  policy: {
+    schema: z.object({ allowed: z.array(z.object({ id: z.string().regex(/^[A-Za-z0-9-]+$/), name: z.string().optional() }).strict()).default([]) }).strict(),
+    fields: [{ key: 'allowed', type: 'rows', label: { zh: '能发起工作的 MoYu 账号', en: 'MoYu accounts that may originate work' },
+      hint: { zh: '填所有者的账号 id（UUID）。平台只把该账号在会话里的消息投递给 Bridge。', en: 'The owner\'s account id (a UUID). The platform delivers only that account\'s conversation messages to the Bridge.' },
+      columns: [{ key: 'id', type: 'text', label: { zh: '账号 id', en: 'Account id' }, pattern: '[A-Za-z0-9\\-]+' }] }],
+    explicit: { zh: '所有者在 MoYu 会话里发出的消息；平台只投递这类消息。', en: 'A message the owner writes in a MoYu conversation; the platform delivers only those.' },
+  },
+  environment: {
+    variables: [
+      { key: 'DSH_SUPERAGENT_WORKSPACE_REPOSITORY', description: { zh: '这次任务冻结的仓库，owner/name。', en: 'The repository frozen for this ticket, as owner/name.' } },
+      { key: 'DSH_SUPERAGENT_WORKSPACE_ACCOUNT', description: { zh: '智能体的 GitHub 账号；除自动合并外的 GitHub 操作都用它。', en: 'The agent\'s GitHub account; use it for every GitHub operation except auto-merge.' } },
+      { key: 'DSH_SUPERAGENT_WORKSPACE_COMMIT_EMAIL', description: { zh: '智能体账号的提交邮箱；提示词没有写明作者时用它提交。', en: 'Commit email of the agent\'s account; commit as it when the instructions name no author.' } },
+      { key: 'DSH_SUPERAGENT_WORKSPACE_BASE_BRANCH', description: { zh: '会话冻结的起始分支。', en: 'The base branch frozen when the conversation started.' } },
+      { key: 'DSH_SUPERAGENT_WORKSPACE_BASE_COMMIT', description: { zh: 'Bridge 校验并冻结的起始 commit；工作从这个 commit 开始。', en: 'The base commit the Bridge verified and froze; start work from it.' } },
+      { key: 'DSH_SUPERAGENT_WORKSPACE_MODEL', description: { zh: '这次任务冻结的模型，写作 provider/model；不可用时任务拒绝启动，不回退。', en: 'The model frozen for this ticket as provider/model; an unavailable one refuses the launch instead of falling back.' } },
+      { key: 'DSH_SUPERAGENT_WORKSPACE_CONVERSATION', description: { zh: '这条消息所属的 MoYu 会话 id。', en: 'The MoYu conversation id this message belongs to.' } },
+    ],
+    values: ({ deployment, config, trigger }) => {
+      const spec = frozenSpecOf(trigger)
+      return {
+        DSH_SUPERAGENT_WORKSPACE_REPOSITORY: spec.repository || deployment.repository || config.repository,
+        DSH_SUPERAGENT_WORKSPACE_ACCOUNT: deployment.github.login,
+        DSH_SUPERAGENT_WORKSPACE_COMMIT_EMAIL: deployment.github.noreply,
+        DSH_SUPERAGENT_WORKSPACE_BASE_BRANCH: spec.baseBranch,
+        DSH_SUPERAGENT_WORKSPACE_BASE_COMMIT: spec.baseCommit,
+        DSH_SUPERAGENT_WORKSPACE_MODEL: workspaceModelLabel(trigger),
+        DSH_SUPERAGENT_WORKSPACE_CONVERSATION: trigger ? workspaceConversation(trigger) : '',
+      }
+    },
+  },
+}
+
+export const name = 'dsh-superagent-workspace'
+export const inject = ['orchestrator']
+/**
+ * Registers the Workspace Source kind. The machine Bridge belongs to the Runtime, not to this plugin: it must see the
+ * Store, the Engine's intake, the deployments, and the model catalog, none of which a Source context exposes.
+ */
+export function apply(ctx: Context): void {
+  ctx.effect(() => {
+    const dispose = ctx.orchestrator.sources.register(workspaceKind)
+    const source = sourceContext(ctx.orchestrator, workspaceKind)
+    source.report(HEALTH, { state: 'ready', detail: 'The machine Bridge delivers workspace triggers', at: new Date().toISOString() })
+    return () => { dispose() }
+  }, 'workspace: source kind')
+}
