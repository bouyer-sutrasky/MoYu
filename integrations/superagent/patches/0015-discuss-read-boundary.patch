+/** A discussion worker may read files only inside its own worktree; credentials outside it stay unreachable. */
+function outsideWorkspace(execution: { name: string; arguments: unknown }, workspace: string | undefined): boolean {
+  if (!workspace || !['read', 'read_image', 'glob', 'grep'].includes(execution.name)) return false
+  const args = (execution.arguments ?? {}) as { file_path?: unknown; path?: unknown }
+  const target = typeof args.file_path === 'string' ? args.file_path : typeof args.path === 'string' ? args.path : undefined
+  if (!target) return false
+  const root = (() => { try { return realpathSync(workspace) } catch { return resolve(workspace) } })()
+  const candidate = resolve(root, target)
+  const resolved = (() => { try { return realpathSync(candidate) } catch { return candidate } })()
+  return resolved !== root && !resolved.startsWith(root + sep)
+}
 
