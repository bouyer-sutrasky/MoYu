+  /**
+   * Emits the one `ticket.imported` event of a GitHub-origin ticket: its GitHub identity, title, state, Trigger, text, and
+   * base. The platform deduplicates by `(repository, 'github', externalId)` and binds the Ticket by `upstream_ticket_id`, so
+   * the deterministic id keeps a restart or a repeated projection tick from importing it twice.
+   */
+  private importTicket(ticket: Ticket, origin: Trigger | undefined): void {
+    if (this.log.has(`ticket-imported:${ticket.id}`)) return
+    const number = githubNumber(ticket, origin)
+    // Without a GitHub number there is no external identity to import under; the Ticket stays a workspace-style record.
+    if (number === undefined) return
+    const url = typeof origin?.url === 'string' && origin.url
+      ? origin.url
+      : `https://github.com/${ticket.base?.repository ?? (this.host.configured() ? this.host.deployment.repository : '')}/${isPr(ticket, origin) ? 'pull' : 'issues'}/${number}`
+    this.log.append(`ticket-imported:${ticket.id}`, 'ticket.imported', ticket.createdAt, {
+      ticketId: ticket.id,
+      source: 'github',
+      externalId: `github:${number}`,
+      number,
+      isPr: isPr(ticket, origin),
+      url,
+      title: ticket.title,
+      state: projectTicketState(ticket),
+      triggerId: ticket.origin.triggerId,
+      text: origin?.text ?? '',
+      base: { branch: ticket.base?.branch ?? '', commit: ticket.base?.commit ?? '', model: modelLabel(ticket.model) },
+      at: ticket.createdAt,
+    })
+  }
