+/** The GitHub number a ticket's origin Trigger, Channel, followed PR thread, or thread names. */
+function githubNumber(ticket: Ticket, origin: Trigger | undefined): number | undefined {
+  const raw = origin?.meta.number
+  if (typeof raw === 'number' && Number.isInteger(raw) && raw > 0) return raw
+  if (typeof raw === 'string' && /^\d+$/.test(raw) && Number(raw) > 0) return Number(raw)
+  for (const channel of ticket.channels) {
+    if (channel.source !== 'github') continue
+    const number = Number(channel.address.number)
+    if (Number.isInteger(number) && number > 0) return number
+  }
+  for (const follow of ticket.follows ?? []) {
+    const match = /^github:(\d+)$/.exec(follow.thread)
+    if (match) return Number(match[1])
+  }
+  for (const ref of origin?.threads ?? []) {
+    if (ref.source !== 'github') continue
+    const match = /^(\d+)$/.exec(ref.id)
+    if (match) return Number(match[1])
+  }
+  return undefined
+}
+/** Whether a GitHub ticket is a pull request, from its Trigger metadata, its Channel URL, or its origin URL. */
+const isPr = (ticket: Ticket, origin: Trigger | undefined): boolean =>
+  origin?.meta.isPr === true || /\/pull\//.test(origin?.url ?? '')
+  || ticket.channels.some(channel => channel.source === 'github' && /\/pull\//.test(channel.address.url ?? ''))
+
