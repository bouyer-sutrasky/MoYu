+describe('GitHub ticket import', () => {
+  /** A GitHub-origin ticket with its origin Trigger, as the GitHub Source created it. */
+  function importedTicket(overrides: Partial<Ticket> = {}): Ticket {
+    const origin = githubTrigger(42)
+    return ticket('g1', { title: 'Fix #42', origin: { triggerId: origin.id, triggerIds: [origin.id] },
+      channels: [origin.channel as ChannelRef], ...overrides })
+  }
+
+  it('emits one ticket.imported with the GitHub identity, text, base, and an initial state update', async () => {
+    const h = harness()
+    h.repo.triggers.save(githubTrigger(42))
+    h.repo.tickets.save(importedTicket())
+    const { bridge, call } = await serve(h)
+    bridge.project()
+    bridge.project()
+    const events = (await call('GET', '/bridge/v1/events')).body.events as { id: string; type: string; data: Record<string, unknown> }[]
+    const imported = events.filter(event => event.type === 'ticket.imported')
+    expect(imported).toHaveLength(1)
+    expect(imported[0]).toMatchObject({ id: 'ticket-imported:g1', data: {
+      ticketId: 'g1', source: 'github', externalId: 'github:42', number: 42, isPr: true,
+      url: 'https://github.com/acme/widgets/pull/42', title: 'Fix #42', state: 'queued', triggerId: 'github-comment:42',
+      text: 'Please fix it', base: { branch: '', commit: '', model: '' }, at: '2026-11-03T12:00:00.000Z' } })
+    const states = events.filter(event => event.type === 'ticket.state_changed')
+    expect(states).toHaveLength(1)
+    expect(states[0]!.data).toMatchObject({ ticketId: 'g1', previousState: null, state: 'queued' })
+  })
+
+  it('imports once across a Bridge restart and continues its state projection', async () => {
+    const dir = stateDir()
+    const first = harness({ stateDir: dir })
+    first.repo.triggers.save(githubTrigger(42))
+    first.repo.tickets.save(importedTicket())
+    const before = await serve(first)
+    before.bridge.project()
+    expect(((await before.call('GET', '/bridge/v1/events')).body.events as unknown[]).length).toBe(2)
+    await before.bridge.stop()
+
+    const second = harness({ stateDir: dir })
+    second.repo.triggers.save(githubTrigger(42))
+    second.repo.tickets.save(importedTicket({ assignments: [{ id: 'as1', state: 'running', createdAt: '2026-11-03T12:00:00.000Z' }],
+      updatedAt: '2026-11-03T12:05:00.000Z' }))
+    const after = await serve(second)
+    after.bridge.project()
+    after.bridge.project()
+    const events = (await after.call('GET', '/bridge/v1/events')).body.events as { type: string; data: Record<string, unknown> }[]
+    expect(events.filter(event => event.type === 'ticket.imported')).toHaveLength(1)
+    expect(events.filter(event => event.type === 'ticket.state_changed').at(-1)!.data).toMatchObject({ ticketId: 'g1', previousState: 'queued', state: 'running' })
+  })
+
+  it('does not import workspace tickets', async () => {
+    const h = harness()
+    h.repo.triggers.save(workspaceTrigger())
+    h.repo.tickets.save(frozen(ticket('t1')))
+    const { bridge, call } = await serve(h)
+    bridge.project()
+    const events = (await call('GET', '/bridge/v1/events')).body.events as { type: string }[]
+    expect(events.some(event => event.type === 'ticket.imported')).toBe(false)
+    expect(events.some(event => event.type === 'ticket.linked')).toBe(true)
+  })
+})
