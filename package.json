{
  "name": "moyu",
  "version": "0.1.0",
  "private": true,
  "description": "MoYu personal agent workspace monorepo",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.22.2",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "dev:api": "pnpm --filter @moyu/api dev",
    "dev:web": "pnpm --filter @moyu/web dev",
    "dev:dispatcher": "pnpm --filter @moyu/dispatcher dev",
    "db:generate": "pnpm --filter @moyu/db db:generate",
    "db:migrate": "pnpm --filter @moyu/db db:migrate",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs,json,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs,json,yml,yaml,css,html}\"",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test && node --test scripts/m3/guard.test.mjs integrations/superagent/tests/verify-lock.test.mjs",
    "test:m3-guard": "node --test scripts/m3/guard.test.mjs",
    "test:verify-lock": "node --test integrations/superagent/tests/verify-lock.test.mjs",
    "test:integration": "pnpm --filter @moyu/db test:integration && pnpm --filter @moyu/api test:integration && pnpm --filter @moyu/dispatcher test:integration",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "auth:bootstrap": "pnpm --filter @moyu/api auth:bootstrap"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.1",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
