# Example unit for the isolated M5-B test service. Install only after the
# repository owner has confirmed the paths, user and database. It is not a
# production deployment record.
[Unit]
Description=MoYu M5-B repository supervisor
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=moyu-m5b
Group=moyu-m5b
# The review check child drops to REVIEW_CHECK_UID/GID; this group carries the
# shared worktree permission the check user and the supervisor both need.
SupplementaryGroups=moyu-check
WorkingDirectory=/opt/moyu/m5b
EnvironmentFile=/etc/moyu/m5b/supervisor.env
Slice=moyu-m5b.slice
# Let the supervisor create, enable and remove its own instance cgroups.
#
# DelegateSubgroup keeps the service's own processes one level down
# (<unit>/payload), so the unit cgroup itself is empty and may hand the memory
# and pids controllers down to the instance cgroups. Without it the kernel
# refuses the hand-down with EBUSY and the supervisor fails the start with an
# explicit `cgroup_unavailable` reason instead of running unmetered.
Delegate=yes
DelegateSubgroup=payload
# The supervisor creates this directory itself, so a blank delegated subtree is
# enough: no operator has to pre-create or enable anything. Keep it inside the
# unit cgroup (verify with `systemctl show -p ControlGroup <unit>`); a directory
# owned by root inside the slice cannot be delegated to this unprivileged user.
# It may instead be set in the EnvironmentFile; do not define it in both.
Environment=MOYU_CGROUP_ROOT=/sys/fs/cgroup/moyu.slice/moyu-m5b.slice/moyu-m5b-supervisor.service/instances
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The supervisor itself is unprivileged. These two capabilities are the whole
# launcher: setpriv drops each check child to REVIEW_CHECK_UID/GID. The bounding
# set removes every other capability, and NoNewPrivileges stays on; without the
# setpriv switch a check fails closed instead of running as the supervisor.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
# The runtime creates worktrees as moyu-m5b; the group and umask let the
# dedicated check user read and write the same tree without a recursive chown.
UMask=0002
ReadWritePaths=/var/lib/moyu-m5b /run/moyu-m5b /var/lib/moyu-check
ExecStart=/opt/moyu/m5b/node_modules/.bin/tsx apps/supervisor/src/main.ts
Restart=on-failure
RestartSec=3
# A start failure must not loop through the whole machine: bounded retries are
# enforced by the supervisor itself (MAX_START_ATTEMPTS).
MemoryMax=8G

[Install]
WantedBy=multi-user.target
