# MoYu configuration example.
# Copy to .env and replace CHANGE_ME locally. Never commit real credentials.
# The repository and logs must not contain tokens, private keys, cookies or real binding codes.

# API process. The deployed entry listens on 127.0.0.1:4300 behind nginx;
# the project-local default is 3100 for direct development.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3100
LOG_LEVEL=info

# PostgreSQL used by the API and dispatcher.
# Local placeholder only; use a dedicated database and scoped credentials outside development.
DATABASE_URL=postgres://moyu:CHANGE_ME@127.0.0.1:5432/moyu

# Integration and browser acceptance tests create and drop isolated databases
# through this admin connection. It is never used by the API or dispatcher.
TEST_DATABASE_ADMIN_URL=postgres://moyu:CHANGE_ME@127.0.0.1:5432/postgres

# WebAuthn. Formal Passkeys are only registered on the final HTTPS domain.
# The origin host must equal the RP ID or be one of its subdomains.
# Local Vite on http://localhost is for layout work only; it cannot complete a
# Passkey ceremony against this production RP ID. Use the HTTPS domain.
WEBAUTHN_RP_ID=moyu.sutrasky.com
WEBAUTHN_RP_NAME=MoYu
WEBAUTHN_ORIGIN=https://moyu.sutrasky.com

# Long-lived owner session (rolling). There is no periodic re-verification timer.
AUTH_SESSION_TTL_DAYS=90
# Server CLI binding code lifetime (generated by `pnpm auth:bootstrap`).
AUTH_BOOTSTRAP_TTL_MINUTES=10
# WebAuthn ceremony challenge lifetime.
AUTH_CHALLENGE_TTL_SECONDS=300
# Optional override. Defaults to true for an https origin and false otherwise.
# AUTH_COOKIE_SECURE=true

# Protected attachment download root. Must be outside the repository in deployment.
ARTIFACT_STORAGE_DIR=.local/artifacts
# Built Web assets served by the API on the deployment origin. Relative to the
# process working directory; run the API from the repository root.
WEB_DIST_DIR=apps/web/dist

# Optional browser build base URL. Leave empty to use same-origin API calls.
VITE_API_BASE_URL=

# M4 repository runtime binding. The Bridge is loopback-only; these values are
# machine configuration, never browser credentials.
# The API binds this repository row on startup (after the owner exists).
BRIDGE_REPOSITORY=Bouyer12/m3-loop-test
BRIDGE_URL=http://127.0.0.1:3190
# Platform -> Bridge machine token. Set the same value as MOYU_BRIDGE_TOKEN in
# the isolated superagent instance environment; never commit the real value.
BRIDGE_TOKEN=CHANGE_ME_BRIDGE_MACHINE_TOKEN
# Bridge -> platform callback token. Set the same value as MOYU_PLATFORM_TOKEN
# in the instance environment.
BRIDGE_CALLBACK_TOKEN=CHANGE_ME_PLATFORM_CALLBACK_TOKEN
# Optional name of the environment variable that holds BRIDGE_TOKEN instead of
# inlining it in this file. The credential reference is stored in the database.
# BRIDGE_CREDENTIAL_REF=MOYU_BRIDGE_TOKEN
BRIDGE_DEFAULT_BRANCH=main
BRIDGE_TIMEOUT_MS=15000

# Dispatcher. It owns durable delivery and Bridge event catch-up.
DELIVERY_INTERVAL_MS=500
DELIVERY_LEASE_MS=60000
DELIVERY_RETRY_CAP_MS=60000
EVENT_SYNC_INTERVAL_MS=1000

# M4 owner commands (start/pause/resume/retry) and runtime leases.
OPERATION_INTERVAL_MS=500
OPERATION_LEASE_MS=60000
# Lease TTL for a resumed task; the dispatcher renews it while the task is active.
OPERATION_LEASE_TTL_MS=3600000
OPERATION_RETRY_CAP_MS=60000
# Reconcile active tasks with the runtime after a platform restart.
RECONCILE_ON_START=true
# Durable duplicate runtime-Ticket pause queue.
DUPLICATE_INTERVAL_MS=500

# M5 host supervisor and per-repository runtime credentials.
# The supervisor is a separate loopback process; the API only sends it an
# already-authorized repository id and a fixed lifecycle action.
SUPERVISOR_URL=http://127.0.0.1:4490
# Shared machine token between API and supervisor. Never sent to a browser.
SUPERVISOR_TOKEN=CHANGE_ME_SUPERVISOR_MACHINE_TOKEN
# Directory owned by the supervisor (0700) containing 0600 per-repository
# credential files. The platform reads only the file named by the repository
# row's credential reference; a global BRIDGE_TOKEN no longer applies to M5
# repositories.
RUNTIME_CREDENTIALS_DIR=/var/lib/moyu/credentials
# Review inspection (M6-A). The supervisor reads the ticket worktree under
# WORKTREE_ROOT and runs these fixed commands there for the owner's check panel.
# The browser and the API never send a path or a command.
REVIEW_DIFF_MAX_BYTES=524288
REVIEW_MAX_FILES=400
REVIEW_CHECK_COMMANDS=["pnpm check"]
REVIEW_CHECK_TIMEOUT_MS=900000

# GitHub CLI signed in to the dedicated account, used to query/add repositories.
GITHUB_CLI=/root/.local/bin/gh-agent

# Supervisor process configuration.
SUPERVISOR_HOST=127.0.0.1
SUPERVISOR_PORT=4490
INSTANCES_CONFIG=/etc/moyu/instances.json
DSH_BIN=/usr/bin/dsh
DSH_HOME=/var/lib/moyu/dsh
PLATFORM_URL=http://127.0.0.1:4300
INSTANCE_ENV_DIR=/var/lib/moyu/instances
INSTANCE_LOG_DIR=/var/lib/moyu/logs
WORKTREE_ROOT=/var/lib/moyu/worktrees
PROFILE_TEMPLATE_DIR=/etc/moyu/profile-template
PROFILE_PREFIX=m5
MAX_ONLINE=2
TICK_INTERVAL_MS=2000
START_TIMEOUT_MS=120000
STOP_TIMEOUT_MS=30000
EXECUTOR_MODEL=commandcode/deepseek/deepseek-v4.1-flash
GITHUB_ALLOWED_USERS=sutrasky
GITHUB_ACCOUNT=Bouyer12
GITHUB_COMMIT_EMAIL=202233540+Bouyer12@users.noreply.github.com
