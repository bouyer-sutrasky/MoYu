# MoYu local configuration example.
# Copy to .env and replace CHANGE_ME locally. Never commit real credentials.
# The repository and logs must not contain tokens, private keys, cookies or real binding codes.

# API process
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3100
LOG_LEVEL=info

# PostgreSQL used by the API and dispatcher.
# Local placeholder only; use a dedicated database and scoped credentials outside development.
DATABASE_URL=postgres://moyu:CHANGE_ME@127.0.0.1:5432/moyu

# Integration tests create and drop isolated databases through this admin connection.
# It is never used by the API or dispatcher.
TEST_DATABASE_ADMIN_URL=postgres://moyu:CHANGE_ME@127.0.0.1:5432/postgres

# Optional browser build base URL. Leave empty to use the Vite development proxy
# (/healthz and /readyz proxied to API_HOST:API_PORT).
VITE_API_BASE_URL=
