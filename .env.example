# MoYu configuration example.
# Copy to .env and replace CHANGE_ME locally. Never commit real credentials.
# The repository and logs must not contain tokens, private keys, cookies or real binding codes.

# API process. The deployed entry listens on 127.0.0.1:4300 behind nginx;
# the project-local default is 3100 for direct development.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3100
LOG_LEVEL=info

# PostgreSQL used by the API and dispatcher.
# Local placeholder only; use a dedicated database and scoped credentials outside development.
DATABASE_URL=postgres://moyu:CHANGE_ME@127.0.0.1:5432/moyu

# Integration and browser acceptance tests create and drop isolated databases
# through this admin connection. It is never used by the API or dispatcher.
TEST_DATABASE_ADMIN_URL=postgres://moyu:CHANGE_ME@127.0.0.1:5432/postgres

# WebAuthn. Formal Passkeys are only registered on the final HTTPS domain.
# The origin host must equal the RP ID or be one of its subdomains.
# Local Vite on http://localhost is for layout work only; it cannot complete a
# Passkey ceremony against this production RP ID. Use the HTTPS domain.
WEBAUTHN_RP_ID=moyu.sutrasky.com
WEBAUTHN_RP_NAME=MoYu
WEBAUTHN_ORIGIN=https://moyu.sutrasky.com

# Long-lived owner session (rolling). There is no periodic re-verification timer.
AUTH_SESSION_TTL_DAYS=90
# Server CLI binding code lifetime (generated by `pnpm auth:bootstrap`).
AUTH_BOOTSTRAP_TTL_MINUTES=10
# WebAuthn ceremony challenge lifetime.
AUTH_CHALLENGE_TTL_SECONDS=300
# Optional override. Defaults to true for an https origin and false otherwise.
# AUTH_COOKIE_SECURE=true

# Protected attachment download root. Must be outside the repository in deployment.
ARTIFACT_STORAGE_DIR=.local/artifacts
# Built Web assets served by the API on the deployment origin. Relative to the
# process working directory; run the API from the repository root.
WEB_DIST_DIR=apps/web/dist

# Optional browser build base URL. Leave empty to use same-origin API calls.
VITE_API_BASE_URL=
